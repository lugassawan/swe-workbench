+    — text, not behaviour — even in a pytest-only run where Node isn't available.
+    """
+    text = PI_EXTENSIONS_INDEX.read_text(encoding="utf-8")
+    assert "promptPaths" in text
+    assert 'join(root, "commands")' in text
