#!/usr/bin/env python3
"""Read-only PR-title scope-drift detector for workflow-branch-sync and
workflow-address-feedback Phase 6.

Compares the bracket scope tags of a PR title (e.g. ``[feat][service-x] Add X``)
against the branch's actual diff scope — the kebab-normalized first path
component of every file changed since the merge-base with the PR's base — and
prints one JSON envelope to stdout (schema ``swb.pr-title-drift/1``, see
shared/docs/runtime-result-contract.md):

``{"schema": "swb.pr-title-drift/1", "status": "ok", "data": {"pr": int,
"title": str, "base": str, "diff_scopes": [...], "type_tags": [...],
"scope_tags": [...], "extra_tags": [...], "missing_scopes": [...],
"verdict": "clean|pure_extra|missing|mixed|no_scope_tags|no_diff",
"suggested_title": str}, "warnings": []}``.

Classification: tokens in the contiguous LEADING bracket prefix from the type
vocabulary (a superset of the conventional type set — over-classifying as type
preserves the tag, the safe direction) are type tags; the other prefix tokens
are scope tags. Brackets in the free-text subject stay free text. Titles with
zero scope tags make the check a no-op, so Conventional-Commits and Jira-prefix
repos never see false drift.

Drift semantics:
- ``extra_tags`` lists only TRIMMABLE extras — tags matching no exact or
  kebab-boundary-prefix path component ANYWHERE in the diff, not just the
  first-component scope set. A tag buried at a deeper path component (or
  naming a versioned component such as `api` → `api-v2`) is layout, not drift.
- ``missing_scopes`` uses only non-docs/CI paths; a docs-only diff suppresses the
  extra-direction too (topical tags on docs PRs are not stale on the diff's
  silence).
- ``suggested_title`` rebuilds type tags + surviving scope tags (+ missing
  scopes) + the original free-text subject. Whether to APPLY it — and the
  auto-trim gate of "at least one scope tag survives" — is policy in the calling
  skills, never here.

Fails closed: if the PR, base, or diff cannot be read, this exits non-zero and
prints nothing on stdout. A non-zero exit never means "clean".

Exit codes: 0 classified (drift or not) | 1 could not classify | 2 bad invocation.

Usage: swe-workbench-pr-title-drift [--pr N] [--title TITLE] [--base REF]
       Defaults resolve the PR for the current branch via `gh pr view`; every
       input is overridable so tests stay hermetic.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from typing import Optional

# Superset of the plugin's own enforcing type set plus the conventional-commit
# extras. Case-insensitive at match time; original casing is preserved in output.
TYPE_VOCAB = frozenset(
    {"feat", "fix", "refactor", "test", "ci", "docs", "perf", "chore", "polish",
     "breaking", "build", "style", "revert"}
)
# is_docs-style heuristic carried over from swe-workbench-preflight-commit: docs
# live in docs/, *.md anywhere except the plugin's runtime markdown trees, and
# .github/ is CI config. Such paths never mint missing scopes.
RUNTIME_MARKDOWN_RE = re.compile(r"^(commands|skills|agents)/")
DOCS_CI_RE = re.compile(r"\.md\Z|^docs/|^\.github/")
BRACKET_TOKEN_RE = re.compile(r"\[([^\[\]]+)\]")
SCHEMA = "swb.pr-title-drift/1"


def kebab(value: str) -> str:
    """Normalize a tag or path component for comparison: lowercase, runs of
    non-alphanumerics to a single hyphen, no leading/trailing hyphens."""
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def is_docs_ci(path: str) -> bool:
    return not RUNTIME_MARKDOWN_RE.search(path) and bool(DOCS_CI_RE.search(path))


def parse_title(title: str) -> tuple[list[str], list[str], str]:
    """Split a title into (type_tags, scope_tags, remainder).

    Only a contiguous leading bracket prefix is metadata. Vocabulary tokens in
    its initial run are types; the first non-vocabulary token ends that run,
    and later prefix tokens are scopes even if their text is vocabulary.
    Brackets in the free-text remainder (for example `[v2]`) are preserved.
    """
    prefix = re.match(r"^(?:\[[^\[\]]+\])+", title)
    if prefix is None:
        return [], [], title

    type_tags: list[str] = []
    scope_tags: list[str] = []
    leading = True
    for match in BRACKET_TOKEN_RE.finditer(prefix.group(0)):
        token = match.group(1)
        if leading and token.lower() in TYPE_VOCAB:
            type_tags.append(token)
        else:
            leading = False
            scope_tags.append(token)
    return type_tags, scope_tags, title[prefix.end():].strip()


def rebuild_title(type_tags: list[str], scope_tags: list[str], remainder: str) -> str:
    head = "".join(f"[{t}]" for t in type_tags + scope_tags)
    return f"{head} {remainder}" if remainder else head


def _run_cmd(argv: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, errors="replace")


def resolve_pr_via_gh() -> tuple[Optional[int], Optional[str], Optional[str]]:
    """PR number, title, and baseRefName for the current branch, via gh.

    Never returns Nones — every failure path raises. There is no meaningful
    "no PR" result distinguishable from a gh failure here, and callers treat
    both as skip-worthy anyway.
    """
    result = _run_cmd(["gh", "pr", "view", "--json", "number,title,baseRefName"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "gh pr view failed")
    payload = json.loads(result.stdout)
    number = payload.get("number")
    return (int(number) if number is not None else None,
            payload.get("title"), payload.get("baseRefName"))


def resolve_base_ref(base: str) -> str:
    """The base as a concrete ref: the origin remote branch if present, else the
    local branch. Raises when neither resolves — never guesses a default."""
    for candidate in (f"refs/remotes/origin/{base}", base):
        result = _run_cmd(["git", "rev-parse", "--verify", "--quiet", candidate])
        if result.returncode == 0 and result.stdout.strip():
            return candidate
    raise RuntimeError(f"base ref does not resolve: {base}")


def changed_paths(base_ref: str) -> Optional[list[str]]:
    """Files changed on HEAD since the merge-base with base_ref, or None when
    the histories share no merge-base (treated as no_diff, not an error).

    -z yields raw, unquoted paths — without it, git escapes quotes and
    non-ASCII bytes under core.quotePath and mints phantom components.
    """
    mb = _run_cmd(["git", "merge-base", "HEAD", base_ref])
    if mb.returncode == 1:
        return None  # git's documented "no common ancestor" result
    if mb.returncode != 0 or not mb.stdout.strip():
        raise RuntimeError(mb.stderr.strip() or "git merge-base failed")
    diff = _run_cmd(["git", "diff", "--name-only", "-z", mb.stdout.strip(), "HEAD"])
    if diff.returncode != 0:
        raise RuntimeError(diff.stderr.strip() or "git diff --name-only -z failed")
    return [p for p in diff.stdout.split("\0") if p]


def classify(title: str, paths: Optional[list[str]]) -> tuple[dict, Optional[str]]:
    """The data payload (and advisory warning code) for one title + changed-path
    set. Pure; no subprocess."""
    type_tags, scope_tags, remainder = parse_title(title)
    if paths is None:
        return _payload(title, [], type_tags, scope_tags, [], [], "no_diff", title), "no_merge_base"
    if not paths:
        return _payload(title, [], type_tags, scope_tags, [], [], "no_diff", title), "no_diff"

    code_paths = [p for p in paths if not is_docs_ci(p)]
    path_parts = [[kebab(part) for part in path.split("/")] for path in paths]
    components = {part for parts in path_parts for part in parts if part}
    diff_scopes: list[str] = []
    code_scopes: list[str] = []
    for path, parts in zip(paths, path_parts):
        if len(parts) > 1 and parts[0] and parts[0] not in diff_scopes:
            diff_scopes.append(parts[0])
        if path in code_paths and len(parts) > 1 and parts[0] and parts[0] not in code_scopes:
            code_scopes.append(parts[0])

    scope_set = {kebab(t) for t in scope_tags}

    def scope_acknowledged(scope: str) -> bool:
        """A code scope is acknowledged when the title tags the scope dir OR any
        module inside it — symmetric with the extra-direction's component rule,
        so a `core/service-y/…` layout neither trims [service-y] nor demands
        [core]."""
        if scope in scope_set:
            return True
        return any(
            parts[0] == scope and any(tag in parts[1:] for tag in scope_set)
            for path, parts in zip(paths, path_parts) if path in code_paths
        )

    missing = [s for s in code_scopes if not scope_acknowledged(s)]
    if code_paths:
        def matches_component(tag: str) -> bool:
            normalized = kebab(tag)
            return any(
                component == normalized or component.startswith(f"{normalized}-")
                for component in components
            )

        extra = [t for t in scope_tags
                 if kebab(t) not in diff_scopes and not matches_component(t)]
    else:
        # Docs-only diff: no code scope to compare against — topical tags are
        # not stale merely because the diff is silent about them.
        extra = []

    if not scope_tags:
        verdict = "no_scope_tags"
    elif extra and missing:
        verdict = "mixed"
    elif extra:
        verdict = "pure_extra"
    elif missing:
        verdict = "missing"
    else:
        verdict = "clean"

    if verdict in ("clean", "no_scope_tags"):
        suggested = title
    else:
        kept = [t for t in scope_tags if kebab(t) not in {kebab(e) for e in extra}]
        suggested = rebuild_title(type_tags, kept + missing, remainder)
    return _payload(title, diff_scopes, type_tags, scope_tags, extra, missing, verdict, suggested), None


def _payload(title: str, diff_scopes: list, type_tags: list, scope_tags: list,
             extra: list, missing: list, verdict: str, suggested: str) -> dict:
    return {
        "pr": 0,  # filled from --pr / gh when known
        "title": title,
        "base": "",  # filled from --base / gh when known
        "diff_scopes": diff_scopes,
        "type_tags": type_tags,
        "scope_tags": scope_tags,
        "extra_tags": extra,
        "missing_scopes": missing,
        "verdict": verdict,
        "suggested_title": suggested,
    }


def main(argv: Optional[list[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="swe-workbench-pr-title-drift",
        description="Read-only PR-title scope-drift detector (see --help output header).",
    )
    parser.add_argument("--pr", type=int, default=None, help="PR number (default: gh pr view)")
    parser.add_argument("--title", default=None, help="PR title (default: live from gh)")
    parser.add_argument("--base", default=None, help="Base ref (default: PR baseRefName)")
    args = parser.parse_args(sys.argv[1:] if argv is None else argv)

    pr = args.pr
    base = args.base
    title = args.title
    try:
        # gh supplies only title/base; a bare --pr override never forces a call.
        if title is None or base is None:
            gh_pr, gh_title, gh_base = resolve_pr_via_gh()
            title = title if title is not None else gh_title
            base = base if base is not None else gh_base
            if pr is None:
                pr = gh_pr
            if title is None or base is None:
                raise RuntimeError("gh pr view returned no title/baseRefName")
        data, warn = classify(title, changed_paths(resolve_base_ref(base)))
        data["pr"] = pr or 0
        data["base"] = base
    except (RuntimeError, OSError, ValueError, json.JSONDecodeError) as exc:
        # OSError covers a missing gh/git binary; empty stdout fails closed.
        print(f"swe-workbench-pr-title-drift: {exc}", file=sys.stderr)
        return 1

    envelope = {
        "schema": SCHEMA,
        "status": "ok",
        "data": data,
        "warnings": ([{"code": warn, "message": f"diff unavailable: {warn}"}]
                     if warn else []),
    }
    json.dump(envelope, sys.stdout, ensure_ascii=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
