#!/usr/bin/env python3
"""Fetch + eligibility projection for workflow-address-feedback's Phase 1.

Usage: swe-workbench-address-feedback-fetch --pr <N>

Wraps bin/swe-workbench-preflight-pr (invoked via a scoped `bash -c` subshell that
`eval`s its `printf %q`-quoted KEY=VALUE output and re-emits the six fields
NUL-delimited — never a python shlex parse of that output, which mishandles
`printf %q`'s `$'...'` ANSI-C-quoted form) to get BASE/HEAD_SHA/AUTHOR_LOGIN/OWNER/
REPO/STATE and the PR JSON file preflight-pr already writes.

Owns the STATE gate internally as a short-circuit: when STATE != "OPEN", the
paginated GraphQL/REST fetch is skipped entirely (no wasted API calls on a closed/
merged PR, preserving today's ordering) and the envelope returns immediately with
threads_path/pr_comments_path empty. The calling skill still owns the
`[ "$STATE" = "OPEN" ]` gate and its user-facing message/reap — it just reads
`.data.state` from this envelope instead of an `eval`'d $STATE.

When OPEN: paginates `reviewThreads` (mirroring bin/swe-workbench-pr-review-submit's
cursor loop) with a per-thread `eligible`/`skip_reason` projection, paginates REST
`issues/{pr}/comments` with the same bot/owner-exclusion + handled-marker/manual-reply
eligibility logic the skill's jq program used to run (ported here as direct python,
unit-tested against the same fixtures that program was tested against), atomically
writes the three snapshot files at repo-scoped paths (owner-repo slug
prefix; legacy un-scoped names when no scope resolves — ratcheted against
swe-workbench-sweep-residuals' own legacy+scoped literal sets), and dual-reads
`${PR}-triage.json` (legacy, only when a same-numbered legacy preflight JSON
also attributes it to this repo) / `<slug>-<PR>-triage.json` (scoped) for
`resume_available` + `resume_triage_path`.

Manifest of paths, not inline records: `data` carries paths/counts/booleans only —
the actual thread/comment records live in the snapshot files, read with `jq`. The
envelope is a control-flow channel (report-once / gate-a-branch); downstream phases
need repeated random access into thread bodies/authors/databaseIds, which belongs in
a file, not a JSON-in-a-shell-variable payload — doubly so since review-comment
bodies are attacker-influenced free text (see bin/swe-workbench-preflight-pr's own
title/body-never-through-eval rule, which this mirrors).

Stdout contract: one JSON envelope on success, schema `swb.address-feedback-fetch/1`
(see shared/docs/runtime-result-contract.md). `status` is "ok" for any successful
fetch, including the not-OPEN short-circuit (that is correct data, not a partial
failure) — "failed" only occurs via a non-zero exit with no stdout at all (preflight
itself failing, or a malformed/unreachable API response), since exit code and status
are orthogonal and an auth/fetch failure means nothing on stdout is trustworthy.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

STATE_DIR = Path("/tmp/swe-workbench-address-feedback")

REVIEW_BATCH_MARKER = "<!-- swe-workbench:review-findings -->"
_REVIEW_BATCH_LINE_RE = re.compile(r"(?m)^<!-- swe-workbench:review-findings -->$")
# Finding IDs are 1-based ordinals the producer assigns; the {0,8} cap keeps int()
# safe from hostile arbitrarily-long digit runs (Python's int/str conversion limit
# raises ValueError past ~4300 digits, which would crash the whole fetch) while
# staying far above any real finding count — a longer digit run simply parses as
# a malformed batch and falls back to legacy one-comment handling.
_REVIEW_FINDING_LINE_RE = re.compile(r"\A<!-- swe-workbench:review-finding:([1-9][0-9]{0,8}) -->\n", re.DOTALL)
_ANY_REVIEW_MARKER_LINE_RE = re.compile(r"(?m)^<!-- swe-workbench:review-(?:findings|finding:[1-9][0-9]{0,8}) -->$")
_BATCH_SEPARATOR = "\n\n---\n\n"

_THREADS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $after) {
        pageInfo { endCursor hasNextPage }
        nodes {
          id isResolved path line startLine
          comments(first: 10) {
            nodes { id databaseId body author { login } }
          }
        }
      }
    }
  }
}
"""


class FetchError(Exception):
    pass


# ── Pure helpers (unit-tested directly) ──────────────────────────────────────


def compute_thread_eligibility(node: dict, current_user: str) -> tuple[bool, str | None]:
    """Rule 1: resolved threads are ineligible. Rule 2: an unresolved thread already
    replied to by $CURRENT_USER (a reply, not the thread-opening comment) is
    ineligible — the owner clarified it in a prior pass but left it unresolved."""
    if node.get("isResolved"):
        return False, "resolved"
    comments = (node.get("comments") or {}).get("nodes") or []
    replies = comments[1:]
    if any(((r.get("author") or {}).get("login") or "") == current_user for r in replies):
        return False, "already-clarified"
    return True, None


def _split_batch_sections(content: str) -> list[str]:
    """Split only at separators immediately followed by a finding-marker line.

    A horizontal rule inside a finding body (the producer's free-text fields may
    legitimately contain them) is byte-identical to the batch separator, so a
    naive split corrupts valid producer batches — only a separator whose next
    line is a finding marker is a real boundary; every other separator stays
    inside the preceding finding's body."""
    sections: list[str] = []
    start = 0
    pos = 0
    while True:
        idx = content.find(_BATCH_SEPARATOR, pos)
        if idx == -1:
            return sections + [content[start:]]
        if _REVIEW_FINDING_LINE_RE.match(content[idx + len(_BATCH_SEPARATOR):]):
            sections.append(content[start:idx])
            start = idx + len(_BATCH_SEPARATOR)
        pos = idx + 1


def parse_review_finding_batch(comment: dict) -> list[dict] | None:
    """Return projections only for a complete producer-formatted finding batch."""
    comment_id = comment.get("id")
    body = comment.get("body")
    if not isinstance(comment_id, int) or comment_id < 1 or not isinstance(body, str):
        return None
    normalized = body.lstrip()
    if not normalized.startswith(REVIEW_BATCH_MARKER):
        return None
    if len(_REVIEW_BATCH_LINE_RE.findall(normalized)) != 1:
        return None
    remainder = normalized[len(REVIEW_BATCH_MARKER):]
    if not remainder.startswith("\n\n"):
        return None

    projections: list[dict] = []
    previous_id = 0
    for section in _split_batch_sections(remainder[2:]):
        marker = _REVIEW_FINDING_LINE_RE.match(section)
        if marker is None:
            return None
        finding_id = int(marker.group(1))
        finding_body = section[marker.end():].strip()
        if finding_id <= previous_id or not finding_body or _ANY_REVIEW_MARKER_LINE_RE.search(finding_body):
            return None
        previous_id = finding_id
        projections.append({
            **comment,
            "body": finding_body,
            "parent_comment_id": comment_id,
            "finding_id": finding_id,
            "triage_key": f"prcomment:{comment_id}:finding:{finding_id}",
            "handled_marker": f"<!-- swe-workbench:handled:{comment_id}:finding:{finding_id} -->",
        })
    return projections or None


def project_legacy_pr_comment(comment: dict) -> dict:
    """Add explicit triage identity to an unmarked PR-level comment."""
    comment_id = comment["id"]
    return {
        **comment,
        "parent_comment_id": comment_id,
        "finding_id": None,
        "triage_key": f"prcomment:{comment_id}",
        "handled_marker": f"<!-- swe-workbench:handled:{comment_id} -->",
    }


def _comment_login(comment: dict) -> str:
    return ((comment.get("user") or {}).get("login") or "")


def _is_bot_comment(comment: dict) -> bool:
    user = comment.get("user") or {}
    return user.get("type") == "Bot" or _comment_login(comment).endswith("[bot]")


def _is_automated_owner_comment(comment: dict) -> bool:
    body = comment.get("body") or ""
    # A batch-shaped comment that fails strict parsing (human edit, truncation) is
    # still tool-origin: only owner comments reach this check, and counting it as a
    # manual reply would hide earlier third-party feedback — re-surfacing is safe.
    return (
        parse_review_finding_batch(comment) is not None
        or "<!-- swe-workbench:handled:" in body
        or body.lstrip().startswith(REVIEW_BATCH_MARKER)
    )


def _is_handled(projection: dict, owner_comments: list[dict]) -> bool:
    generic_marker = f"<!-- swe-workbench:handled:{projection['parent_comment_id']} -->"
    return any(
        generic_marker in (owner_comment.get("body") or "")
        or projection["handled_marker"] in (owner_comment.get("body") or "")
        for owner_comment in owner_comments
    )


def compute_pr_comment_eligibility(comments: list[dict], author: str, me: str) -> list[dict]:
    """Project valid marked batches and keep legacy comments addressable on re-runs."""
    owner_comments = [comment for comment in comments if _comment_login(comment) in (author, me)]
    candidates: list[dict] = []
    for comment in comments:
        if _is_bot_comment(comment):
            continue
        batch = parse_review_finding_batch(comment)
        if batch is not None:
            candidates.extend(batch)
        elif _comment_login(comment) not in (author, me):
            candidates.append(project_legacy_pr_comment(comment))

    result = []
    for candidate in candidates:
        manual_reply = any(
            not _is_automated_owner_comment(owner_comment)
            and (owner_comment.get("created_at") or "") > (candidate.get("created_at") or "")
            for owner_comment in owner_comments
        )
        result.append({**candidate, "eligible": not (_is_handled(candidate, owner_comments) or manual_reply)})
    return result


# ── gh layer ─────────────────────────────────────────────────────────────────


def _script_dir() -> Path:
    return Path(__file__).resolve().parent


def _check_siblings(script_dir: Path) -> None:
    for name in ("swe-workbench-preflight-pr", "swe-workbench-gh-timeout", "swe-workbench-repo-scope"):
        path = script_dir / name
        if not (path.is_file() and os.access(path, os.X_OK)):
            raise FetchError(
                f"sibling script {name} not found at {path} — reinstall or update the swe-workbench plugin."
            )


def resolve_scope_slug(repo_arg: str | None, script_dir: Path) -> str:
    """Ladder: explicit --repo -> cwd origin -> '' (legacy naming).
    Empty slug means legacy un-scoped paths; never fatal on its own."""
    cmd = [str(script_dir / "swe-workbench-repo-scope")]
    if repo_arg:
        cmd += ["--repo", repo_arg]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def _legacy_triage_attributable(pr: str, owner: str, repo: str) -> bool:
    """True iff a same-numbered legacy (un-scoped) preflight JSON exists in
    STATE_DIR and its own .url attributes to this repo. The legacy triage
    file itself carries no owner/repo field, so this is the only signal
    available — mirrors swe-workbench-sweep-residuals' sibling-attribution
    pattern for $N-threads.json (paired with the preflight JSON's own .url)
    rather than trusting an un-scoped leftover by presence alone. Absent or
    unreadable/mismatched -> not attributable (fail closed, same default as
    every other legacy-attribution rule in this scheme)."""
    try:
        legacy_data = json.loads((STATE_DIR / f"{pr}.json").read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return False
    url = legacy_data.get("url") or ""
    m = re.match(r"^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/pull/[0-9]+/?$", url)
    return bool(m) and m.group(1) == owner and m.group(2) == repo


def _gh(args: list[str], script_dir: Path) -> subprocess.CompletedProcess:
    cmd = ["bash", str(script_dir / "swe-workbench-gh-timeout"), *args]
    return subprocess.run(cmd, input="", capture_output=True, text=True)


def _gh_json(args: list[str], script_dir: Path):
    """Returns (data, proc) — data is None on non-zero exit or unparseable stdout."""
    proc = _gh(args, script_dir)
    if proc.returncode != 0:
        return None, proc
    try:
        return json.loads(proc.stdout), proc
    except (json.JSONDecodeError, ValueError):
        return None, proc


def run_preflight(pr: str, out_json: Path, script_dir: Path) -> dict:
    """Runs swe-workbench-preflight-pr in a scoped bash -c subshell that evals its
    printf-%q output and re-emits the six fields NUL-delimited. Non-zero exit means
    preflight itself failed (auth, PR not found) — the caller must not trust anything
    on this function's return in that case; it raises instead."""
    preflight = script_dir / "swe-workbench-preflight-pr"
    bash_script = (
        'OUT=$("$1" "$2" "$3"); RC=$?; '
        '[ "$RC" -eq 0 ] || exit "$RC"; '
        "eval \"$OUT\"; "
        'printf "%s\\0%s\\0%s\\0%s\\0%s\\0%s\\0" '
        '"$BASE" "$HEAD_SHA" "$AUTHOR_LOGIN" "$OWNER" "$REPO" "$STATE"'
    )
    proc = subprocess.run(
        ["bash", "-c", bash_script, "--", str(preflight), pr, str(out_json)],
        capture_output=True,
    )
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", errors="replace").strip()
        raise FetchError(f"preflight failed for PR #{pr}: {detail or 'no diagnostic output'}")
    parts = proc.stdout.split(b"\0")
    if len(parts) < 6:
        raise FetchError(f"preflight produced unexpected output for PR #{pr}")
    base, head_sha, author_login, owner, repo, state = (p.decode("utf-8") for p in parts[:6])
    return {
        "base": base,
        "head_sha": head_sha,
        "author_login": author_login,
        "owner": owner,
        "repo": repo,
        "state": state,
    }


def fetch_current_user(script_dir: Path) -> str:
    proc = _gh(["api", "/user", "-q", ".login"], script_dir)
    if proc.returncode != 0:
        raise FetchError(f"failed to fetch current user: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout.strip()


def fetch_threads(owner: str, repo: str, pr: str, current_user: str, script_dir: Path) -> list[dict]:
    threads: list[dict] = []
    after: str | None = None
    while True:
        args = [
            "api",
            "graphql",
            "-F",
            f"number={pr}",
            "-F",
            f"owner={owner}",
            "-F",
            f"repo={repo}",
            "-f",
            f"query={_THREADS_QUERY}",
        ]
        if after:
            args += ["-F", f"after={after}"]
        data, proc = _gh_json(args, script_dir)
        if data is None:
            raise FetchError(f"failed to fetch review threads: {proc.stderr.strip() or proc.stdout.strip()}")
        try:
            rt = data["data"]["repository"]["pullRequest"]["reviewThreads"]
        except (KeyError, TypeError) as exc:
            raise FetchError(f"unexpected reviewThreads response shape: {exc}") from exc
        for node in rt.get("nodes") or []:
            eligible, skip_reason = compute_thread_eligibility(node, current_user)
            threads.append({**node, "eligible": eligible, "skip_reason": skip_reason})
        page = rt.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        after = page.get("endCursor")
        if not after:
            raise FetchError("reviewThreads reported hasNextPage without an endCursor")
    return threads


def fetch_pr_comments_raw(owner: str, repo: str, pr: str, script_dir: Path) -> list[dict]:
    proc = _gh(["api", "--paginate", f"repos/{owner}/{repo}/issues/{pr}/comments", "--jq", ".[]"], script_dir)
    if proc.returncode != 0:
        raise FetchError(f"failed to fetch PR comments: {proc.stderr.strip() or proc.stdout.strip()}")
    comments: list[dict] = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            comments.append(json.loads(line))
        except (json.JSONDecodeError, ValueError) as exc:
            raise FetchError(f"malformed PR comment JSON from gh: {exc}") from exc
    return comments


# ── Atomic write ──────────────────────────────────────────────────────────────


def _atomic_write_json(path: Path, data) -> None:
    # mkdir's mode is a no-op on an already-existing directory (it never chmods) —
    # by this point bin/swe-workbench-fetch-pr's own `mkdir -p` has typically already
    # created STATE_DIR with default (not 0700) permissions, so the explicit chmod
    # is what actually makes this tightening effective, not the mkdir call alone.
    path.parent.mkdir(mode=0o700, exist_ok=True)
    os.chmod(path.parent, 0o700)
    tmp = path.parent / f".{path.name}.tmp-{os.getpid()}"
    tmp.write_text(json.dumps(data, ensure_ascii=True))
    os.replace(tmp, path)


# ── Envelope ─────────────────────────────────────────────────────────────────


def _build_envelope(*, resume_available: bool, **data) -> dict:
    nothing_to_address = data["eligible_threads"] == 0 and data["eligible_pr_comments"] == 0
    return {
        "schema": "swb.address-feedback-fetch/1",
        "status": "ok",
        "data": {**data, "nothing_to_address": nothing_to_address, "resume_available": resume_available},
        "warnings": [],
    }


# ── CLI ──────────────────────────────────────────────────────────────────────


def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="swe-workbench-address-feedback-fetch")
    p.add_argument("--pr", required=True)
    p.add_argument("--repo", default=None, help="owner/repo scope for state-file names "
                   "; defaults to the cwd's origin remote, else legacy names")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_arg_parser().parse_args(argv)
    pr = args.pr

    if not re.match(r"^[1-9][0-9]*$", pr):
        print(f"swe-workbench-address-feedback-fetch: --pr must match [1-9][0-9]*, got {pr!r}", file=sys.stderr)
        return 1

    script_dir = _script_dir()

    if args.repo is not None and not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$", args.repo):
        print(f"swe-workbench-address-feedback-fetch: invalid --repo value: {args.repo!r} (expected owner/repo)", file=sys.stderr)
        return 1

    try:
        _check_siblings(script_dir)

        slug = resolve_scope_slug(args.repo, script_dir)
        stem = f"{slug}-{pr}" if slug else pr
        legacy_triage_path = STATE_DIR / f"{pr}-triage.json"
        pr_json_path = STATE_DIR / f"{stem}.json"
        preflight = run_preflight(pr, pr_json_path, script_dir)
        owner, repo, state = preflight["owner"], preflight["repo"], preflight["state"]

        try:
            pr_data = json.loads(pr_json_path.read_text())
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            raise FetchError(f"could not read {pr_json_path}: {exc}") from exc
        pr_branch = pr_data.get("headRefName") or ""

        triage_path = STATE_DIR / f"{stem}-triage.json"
        threads_path = STATE_DIR / f"{stem}-threads.json"
        pr_comments_path = STATE_DIR / f"{stem}-pr-comments.json"
        # Dual-read: a pre-upgrade session's resume point lives at
        # the legacy un-scoped triage path — still visible to a scoped run,
        # but only when a same-numbered legacy preflight JSON also exists and
        # attributes to this repo (see _legacy_triage_attributable) — an
        # un-scoped leftover from a DIFFERENT repository's earlier
        # same-numbered PR must never be silently offered as a resume point.
        # resume_triage_path locates where the data actually lives (slugged if
        # present, else attributable legacy, else empty); triage_path keeps
        # naming where new saves go, so the resume offer can point at a
        # readable file while every save migrates to the scoped spelling.
        legacy_triage_attributable = (
            slug != "" and legacy_triage_path.exists() and _legacy_triage_attributable(pr, owner, repo)
        )
        resume_triage_path = ""
        if triage_path.exists():
            resume_triage_path = str(triage_path)
        elif legacy_triage_attributable:
            resume_triage_path = str(legacy_triage_path)
        resume_available = triage_path.exists() or legacy_triage_attributable

        if state != "OPEN":
            envelope = _build_envelope(
                state=state,
                owner=owner,
                repo=repo,
                author_login=preflight["author_login"],
                current_user="",
                pr_branch=pr_branch,
                base=preflight["base"],
                head_sha=preflight["head_sha"],
                pr_json_path=str(pr_json_path),
                threads_path="",
                pr_comments_path="",
                triage_path=str(triage_path),
                resume_triage_path=resume_triage_path,
                eligible_threads=0,
                skipped_threads_clarified=0,
                eligible_pr_comments=0,
                skipped_pr_comments=0,
                resume_available=resume_available,
            )
        else:
            current_user = fetch_current_user(script_dir)
            threads = fetch_threads(owner, repo, pr, current_user, script_dir)
            pr_comments_raw = fetch_pr_comments_raw(owner, repo, pr, script_dir)
            pr_comments = compute_pr_comment_eligibility(pr_comments_raw, preflight["author_login"], current_user)

            _atomic_write_json(threads_path, threads)
            _atomic_write_json(pr_comments_path, pr_comments)

            envelope = _build_envelope(
                state=state,
                owner=owner,
                repo=repo,
                author_login=preflight["author_login"],
                current_user=current_user,
                pr_branch=pr_branch,
                base=preflight["base"],
                head_sha=preflight["head_sha"],
                pr_json_path=str(pr_json_path),
                threads_path=str(threads_path),
                pr_comments_path=str(pr_comments_path),
                triage_path=str(triage_path),
                resume_triage_path=resume_triage_path,
                eligible_threads=sum(1 for t in threads if t["eligible"]),
                skipped_threads_clarified=sum(1 for t in threads if t.get("skip_reason") == "already-clarified"),
                eligible_pr_comments=sum(1 for c in pr_comments if c["eligible"]),
                skipped_pr_comments=sum(1 for c in pr_comments if not c["eligible"]),
                resume_available=resume_available,
            )
    except FetchError as exc:
        print(f"swe-workbench-address-feedback-fetch: {exc}", file=sys.stderr)
        return 1

    json.dump(envelope, sys.stdout, ensure_ascii=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
