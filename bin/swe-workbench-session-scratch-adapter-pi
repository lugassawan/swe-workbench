#!/usr/bin/env bash
# Pi authorizes no scratch target until a sanctioned contract exists; never derive one
# from session JSONL.
# Usage: swe-workbench-session-scratch-adapter-pi

set -euo pipefail

if [ $# -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
  exit 0
fi

note() {
  printf 'session-scratch-adapter-pi: %s\n' "$*" >&2
}

SESSION_ID="${PI_SESSION_ID:-}"
[[ -n "$SESSION_ID" ]] || exit 3

case "$SESSION_ID" in
  *[[:cntrl:]]*)
    note "PI_SESSION_ID contains control characters"
    exit 4
    ;;
esac

note "Pi exposes session metadata but no sanctioned session scratch path — skipping"
exit 4
