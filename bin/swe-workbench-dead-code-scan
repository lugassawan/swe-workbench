#!/usr/bin/env python3
"""Dead/test-only code scanner emitting the standard JSON envelope.

Dead-code detection at three touchpoints (audit, refactor, review) is backed by
this one pure scanner: it never runs git; it may take orchestrator-supplied diff
text (`--diff-from`) as a scope hint. Without it the whole repo is scanned and
orchestrators filter the candidates consumer-side. With it (grep funnel only)
the index keeps just the symbols the diff defines or orphans, so a large repo
stays inside the file cap, and only rows tied to the diff are emitted.

Detection funnel (first available wins for candidate sourcing; the text index
below always runs so every candidate carries reference evidence):
  1. native tooling when installed and applicable to the repo (vulture needs
     Python sources, staticcheck a go.mod, knip a package.json — an
     inapplicable tool is a designed skip, not a failure),
  2. the sibling swe-workbench-lsp script (callers verification pass),
  3. an in-process one-pass identifier index (the "grep" funnel) — never a
     subprocess per candidate.

Determinism floor vs judgment: the script owns mechanism only — funnel
selection, structural safe-keep detection (exports, CLI entry points, dynamic
references), the `dead-code: keep <reason>` marker, and adjacent-comment
capture into `note`. Whether a captured comment *justifies* keeping the symbol
is agent judgment, applied downstream. Neither safe-keep nor justified rows
are ever auto-removable.

Envelope (validated by swe-workbench-result-check swb.dead-code-scan/1):
  {"schema": "swb.dead-code-scan/1", "status": "ok"|"partial",
   "data": {"root", "funnel", "scanned_files", "candidate_count",
            "safe_keep_count", "justified_count", "scope" ("repo"|"diff"),
            "scoped_paths", "watched_symbols", "candidates": [...]},
   "warnings": [{"code", "message"}]}

Each candidate row: {"symbol", "kind", "path", "line", "keep_class"
(candidate|safe-keep|justified), "keep_reason", "note", "detected_by",
"test_only", "diff_relation", "references": [{"path", "reason"}]} — the reason
field is "test" (references are only attached to test-only rows; used symbols
are omitted entirely). `diff_relation` is "" in repo mode; in diff mode it is
"added" (the def sits on a `+` line) or "orphaned" (a candidate whose name
appears on a deleted non-test line); rows with neither are not emitted.

Exit 0 with a valid envelope even when candidates were found — findings are
not failures. "partial" plus a warning reports degradation (file cap hit, LSP
error mid-scan, native tool failure, a diff path not found under the root); designed fallbacks (tool absent) stay
"ok". Non-zero exit means the scan could not run at all; stdout stays empty
and the diagnostic goes to stderr.
"""

from __future__ import annotations

import argparse
import configparser
import glob
import json
import os
import posixpath
import re
import shutil
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path
from typing import NamedTuple

try:
    import tomllib
except ImportError:  # Python < 3.11: pyproject.toml entry points go unmodeled
    tomllib = None

SCHEMA = "swb.dead-code-scan/1"

DEFAULT_MAX_FILES = 5000
# A diff-scoped scan keeps only watched-symbol membership per file, so memory no
# longer grows with the file count and the cap can sit far higher.
DEFAULT_MAX_SCOPED_FILES = 50000
MAX_LSP_VERIFIES = 50
MARKER_NOTE_MAX = 300
MAX_DECORATOR_SPAN = 30  # lines walked upward to find a multi-line decorator's opener

# Directories never scanned and whose references never count as usage.
EXCLUDED_DIRS = {
    ".git", ".hg", ".svn", "node_modules", "dist", "build", "out",
    ".venv", "venv", "__pycache__", ".mypy_cache", ".pytest_cache",
    "target", "coverage", ".superpowers", ".rimba", ".claude", ".cache",
}

SOURCE_EXTS = {
    ".py", ".pyi", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs",
    ".go", ".rb", ".rs", ".sh", ".bash",
}

# Manifests walked alongside sources: they declare entry points the text index
# can never see referenced.
MANIFEST_NAMES = {"package.json", "pyproject.toml", "setup.cfg"}

TEST_PATH_RE = re.compile(
    r"(^|/)(tests?|__tests__|spec)(/|$)|(^|/)(test|spec)[._-]|[._-](test|spec)[._]|\.(test|spec)\.",
    re.IGNORECASE,
)

IDENT_RE = re.compile(r"[A-Za-z_$][\w$]*")
MARKER_RE = re.compile(r"dead-code:\s*keep\s+(.+?)\s*$")
DUNDER_RE = re.compile(r"^__\w+__$")
RUST_PUB_RE = re.compile(r"pub\s")  # bare `pub` only — pub(crate)/pub(super) are not external API
# `#[`/`#![` is a Rust attribute, not a comment.
COMMENT_TAIL_RE = re.compile(r"(?:^|\s+)(?:#(?!!?\[)|//).*$")
DECORATOR_RE = re.compile(r"^(?:@\s*|#!?\[\s*)([\w:.]+)")
SHEBANG_RE = re.compile(r"(?:/|\s)(python[\d.]*|nodejs|node|bash|zsh|sh|ruby)\b")
SHEBANG_EXTS = {
    "python": ".py", "node": ".js", "nodejs": ".js", "bash": ".sh", "zsh": ".sh", "sh": ".sh", "ruby": ".rb",
}
# Decorators/attributes that modify a def without registering it anywhere, so
# an unused def carrying only these is still dead.
NON_REGISTERING = {
    "staticmethod", "classmethod", "property", "setter", "getter", "deleter",
    "abstractmethod", "override", "final", "overload", "cached_property",
    "lru_cache", "cache", "wraps", "derive", "inline", "allow", "warn", "deny",
    "cfg", "doc", "must_use", "repr", "deprecated", "cold",
}
DYNAMIC_CALL_RE = re.compile(
    r"\b(getattr|import_module|__import__|require|send|const_get|method_missing)\s*\("
)
QUOTED_IDENT_RE = re.compile(r"['\"]([A-Za-z_$][\w$]*)['\"]")
ALL_RE = re.compile(r"__all__\s*=\s*[\[(](.*?)[\])\)]", re.DOTALL)
QUOTED_ANY_RE = re.compile(r"['\"]([^'\"]+)['\"]")

# (pattern, kind, name_group) per extension; Python methods vs functions are
# told apart by indentation in the parser, not here.
DEF_RULES: dict[str, list[tuple[re.Pattern, str, int]]] = {
    ".py": [
        (re.compile(r"^(\s*)(?:async\s+)?def\s+([A-Za-z_]\w*)"), "def", 2),
        (re.compile(r"^\s*class\s+([A-Za-z_]\w*)"), "class", 1),
    ],
    ".js": [
        (re.compile(r"^\s*(export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)"), "function", 2),
        (re.compile(r"^\s*(export\s+)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)"), "class", 2),
    ],
    ".go": [
        (re.compile(r"^func\s+(?:\([^)]*\)\s*)?([A-Za-z_]\w*)\s*\("), "function", 1),
        (re.compile(r"^type\s+([A-Za-z_]\w*)\s+struct\b"), "type", 1),
    ],
    ".rb": [
        (re.compile(r"^\s*def\s+([A-Za-z_]\w*)[?!]?"), "function", 1),
        (re.compile(r"^\s*(?:class|module)\s+([A-Za-z_]\w*)"), "class", 1),
    ],
    ".rs": [
        (re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+([A-Za-z_]\w*)"), "function", 1),
        (re.compile(r"^\s*(?:pub\s+)?(?:struct|enum|trait)\s+([A-Za-z_]\w*)"), "type", 1),
    ],
}
# pyi mirrors py
DEF_RULES[".pyi"] = DEF_RULES[".py"]
for _ext in (".jsx", ".ts", ".tsx", ".mjs", ".cjs"):
    DEF_RULES[_ext] = DEF_RULES[".js"]


def _warning(code: str, message: str) -> dict:
    return {"code": code, "message": message}


# ── File parsing (one pass, in-process) ─────────────────────────────────────


class DefHit:
    __slots__ = ("name", "kind", "path", "line", "exported", "marker_reason", "note", "registered", "self_used")

    def __init__(
        self, name, kind, path, line, exported=False, marker_reason=None, note="", registered=False, self_used=False
    ):
        self.name = name
        self.kind = kind
        self.path = path
        self.line = line
        self.exported = exported
        self.marker_reason = marker_reason
        self.note = note
        self.registered = registered
        self.self_used = self_used  # named on another non-declaration line of its own file


class FileRecord:
    __slots__ = ("relpath", "idents", "dynamic", "defs", "all_names")

    def __init__(self, relpath):
        self.relpath = relpath
        self.idents: set[str] = set()
        self.dynamic: set[str] = set()
        self.defs: list[DefHit] = []
        self.all_names: set[str] = set()


def _comment_text_above(lines: list[str], idx: int, comment_prefixes: tuple[str, ...]) -> str:
    """Contiguous comment lines directly above line idx (1-based), joined."""
    collected: list[str] = []
    j = idx - 2  # 0-based index of the line above the 1-based line idx
    while j >= 0:
        stripped = lines[j].strip()
        if stripped.startswith(comment_prefixes):
            text = stripped.lstrip("/#* ").removesuffix("*/").strip()
            if text:
                collected.append(text)
            j -= 1
        else:
            break
    return " ".join(reversed(collected))[:MARKER_NOTE_MAX]


def _decorator_starts(ext: str) -> tuple[str, ...]:
    if ext == ".rs":
        return ("#[", "#![")
    if ext in {".go", ".rb", ".sh", ".bash"}:
        return ()
    return ("@",)


def _decorator_start(lines: list[str], j: int, starts: tuple[str, ...]) -> int | None:
    """0-based index of the decorator/attribute that ends at line j, else None.
    A line ending in a closing bracket (trailing comment aside) is walked upward
    until the brackets balance, and counts only if that opening line carries a
    decorator marker. A bracket inside a string literal is out of scope."""
    if lines[j].lstrip().startswith(starts):
        return j
    if not COMMENT_TAIL_RE.sub("", lines[j]).rstrip().endswith((")", "]")):
        return None
    balance = 0
    for k in range(j, max(j - MAX_DECORATOR_SPAN, -1), -1):
        code = COMMENT_TAIL_RE.sub("", lines[k])
        balance += sum(code.count(c) for c in ")]}") - sum(code.count(c) for c in "([{")
        if balance <= 0:
            return k if lines[k].lstrip().startswith(starts) else None
    return None


def _decorators_above(lines: list[str], idx: int, starts: tuple[str, ...]) -> tuple[int, list[str]]:
    """Decorator/attribute blocks directly above line idx (1-based), multi-line
    ones included. Returns the 1-based line of the topmost one (idx when none)
    and their bare names."""
    top, names = idx, []
    j = idx - 2
    while starts and j >= 0:
        k = _decorator_start(lines, j, starts)
        if k is None:
            break
        m = DECORATOR_RE.match(lines[k].strip())
        if m:
            names.append(m.group(1).replace("::", ".").rsplit(".", 1)[-1])
        top = k + 1
        j = k - 1
    return top, names


def _shebang_ext(path: Path) -> str:
    """Source extension implied by an extensionless script's shebang, else ''."""
    try:
        with path.open("rb") as fh:
            head = fh.readline(200)
    except OSError:
        return ""
    if not head.startswith(b"#!"):
        return ""
    m = SHEBANG_RE.search(head.decode("utf-8", errors="replace"))
    if not m:
        return ""
    word = m.group(1)
    return SHEBANG_EXTS.get("python" if word.startswith("python") else word, "")


def _source_ext(path: Path) -> str:
    """Effective source extension: the real one, or a shebang-derived one for
    extensionless executables (`bin/tool`); '' when not a source file."""
    ext = path.suffix.lower()
    if ext in SOURCE_EXTS:
        return ext
    return "" if ext else _shebang_ext(path)


def _is_exported(ext: str, matched: str, name: str) -> bool:
    """Language export conventions for non-`def` rules: JS/TS `export`, Rust
    bare `pub`, Go's capitalized identifiers."""
    if ext == ".go":
        return name[:1].isupper()
    if ext == ".rs":
        return RUST_PUB_RE.match(matched.lstrip()) is not None
    return matched.lstrip().startswith("export ")


def parse_file(root: Path, path: Path) -> FileRecord | None:
    ext = _source_ext(path)
    if not ext:
        return None
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    return parse_text(path.relative_to(root).as_posix(), ext, text)


def parse_text(rel: str, ext: str, text: str) -> FileRecord:
    # "\n" only: splitlines() also breaks on \f, \v, \x1c-\x1e, \x85 and  ,
    # which would shift every later line number away from the diff's.
    lines = text.split("\n")
    if lines[-1] == "":
        lines.pop()
    record = FileRecord(rel)

    line_idents_by_line: list[set[str]] = []
    use_lines: dict[str, int] = {}  # identifier → count of non-declaration lines naming it
    for no, line in enumerate(lines, start=1):
        line_idents = set(IDENT_RE.findall(line))
        line_idents_by_line.append(line_idents)
        record.idents.update(line_idents)
        if not _is_declaration_only(line):
            for ident in line_idents:
                use_lines[ident] = use_lines.get(ident, 0) + 1
        if DYNAMIC_CALL_RE.search(line):
            record.dynamic.update(QUOTED_IDENT_RE.findall(line))

    rules = DEF_RULES.get(ext, [])
    if ext in {".py", ".pyi", ".rb", ".sh", ".bash"}:
        comment_prefixes = ("#", "//")
    else:  # C-family: line comments plus /* … */ and JSDoc-style ` * …` bodies
        comment_prefixes = ("//", "#", "/*", "*")
    decorator_starts = _decorator_starts(ext)
    for no, line in enumerate(lines, start=1):
        for pattern, base_kind, name_group in rules:
            m = pattern.match(line)
            if not m:
                continue
            if base_kind == "def":
                indent, name = m.group(1), m.group(name_group)
                kind = "method" if indent else "function"
                exported = False
            else:
                name = m.group(name_group)
                kind = base_kind
                exported = _is_exported(ext, m.group(0), name)
            # Notes and markers sit above any decorators/attributes, not just the def line.
            deco_top, deco_names = _decorators_above(lines, no, decorator_starts)
            registered = any(n not in NON_REGISTERING for n in deco_names)
            note = _comment_text_above(lines, deco_top, comment_prefixes)
            marker_reason = None
            # docstring on the line directly below also carries marker/note
            if no < len(lines):
                below = lines[no].strip()
                if below.startswith(('"""', "'''", '"', "'")):
                    doc = below.strip("\"'")
                    if doc and not note:
                        note = doc[:MARKER_NOTE_MAX]
                    below_marker = MARKER_RE.search(below)
                    if below_marker:
                        marker_reason = below_marker.group(1).strip()
            if marker_reason is None:
                marker = MARKER_RE.search(note) or MARKER_RE.search(line)
                if marker:
                    marker_reason = marker.group(1).strip()
            on_def_line = name in line_idents_by_line[no - 1] and not _is_declaration_only(line)
            self_used = use_lines.get(name, 0) - on_def_line > 0
            record.defs.append(DefHit(name, kind, rel, no, exported, marker_reason, note, registered, self_used))
            break

    if ext in {".py", ".pyi"}:
        for all_block in ALL_RE.findall(text):
            record.all_names.update(QUOTED_ANY_RE.findall(all_block))
    return record


def walk_files(root: Path, max_files: int, warnings: list) -> list[Path]:
    files: list[Path] = []
    capped = False
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in EXCLUDED_DIRS)
        for name in sorted(filenames):
            path = Path(dirpath) / name
            if name in MANIFEST_NAMES or _source_ext(path):
                files.append(path)
                if len(files) >= max_files:
                    capped = True
                    break
        if capped:
            break
    if capped:
        warnings.append(_warning("file-cap", f"file cap {max_files} reached; scan truncated"))
    return files


class EntryPoints:
    """Manifest-declared entry points. `files` are repo-root-relative paths that
    run as a whole (package.json bin/main); `symbols` are callable names the
    runtime invokes by name (Python console-script targets)."""

    __slots__ = ("files", "symbols")

    def __init__(self, files: set[str] | None = None, symbols: set[str] | None = None):
        self.files = files if files is not None else set()
        self.symbols = symbols if symbols is not None else set()


def _manifest_relative(root: Path, manifest: Path, entry: str) -> str | None:
    """Resolve a manifest-relative entry path to repo-root-relative posix form;
    None when it escapes the scan root."""
    resolved = Path(os.path.normpath(manifest.parent / entry))
    try:
        return resolved.relative_to(root).as_posix()
    except ValueError:
        return None


def _package_json_entries(root: Path, manifest_path: Path, entries: EntryPoints) -> None:
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, ValueError):
        return
    if not isinstance(manifest, dict):
        return
    declared: list[str] = []
    bin_field = manifest.get("bin")
    if isinstance(bin_field, str):
        declared.append(bin_field)
    elif isinstance(bin_field, dict):
        declared.extend(str(v) for v in bin_field.values())
    main_field = manifest.get("main")
    if isinstance(main_field, str):
        declared.append(main_field)
    for entry in declared:
        rel = _manifest_relative(root, manifest_path, entry)
        if rel is not None:
            entries.files.add(rel)


def _symbols_from_target(target: str) -> set[str]:
    """`pkg.mod:Class.attr [extra]` → {"Class", "attr"}; module-only targets
    (no `:`) name no callable."""
    _, sep, attr = target.partition(":")
    if not sep:
        return set()
    attr = attr.split("[", 1)[0]
    return {seg.strip() for seg in attr.split(".") if seg.strip().isidentifier()}


def _toml_entry_targets(manifest: dict) -> list[str]:
    """Targets from [project.scripts|gui-scripts|entry-points.*] and the Poetry
    equivalents ([tool.poetry.scripts|plugins.*])."""
    tables: list[object] = []
    project = manifest.get("project")
    if isinstance(project, dict):
        tables.extend([project.get("scripts"), project.get("gui-scripts")])
        groups = project.get("entry-points")
        if isinstance(groups, dict):
            tables.extend(groups.values())
    tool = manifest.get("tool")
    poetry = tool.get("poetry") if isinstance(tool, dict) else None
    if isinstance(poetry, dict):
        tables.append(poetry.get("scripts"))
        plugins = poetry.get("plugins")
        if isinstance(plugins, dict):
            tables.extend(plugins.values())
    return [v for table in tables if isinstance(table, dict) for v in table.values() if isinstance(v, str)]


def _pyproject_entries(manifest_path: Path, entries: EntryPoints) -> None:
    if tomllib is None:
        return
    try:
        manifest = tomllib.loads(manifest_path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, ValueError):
        return
    for target in _toml_entry_targets(manifest):
        entries.symbols.update(_symbols_from_target(target))


def _setup_cfg_entries(manifest_path: Path, entries: EntryPoints) -> None:
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read_string(manifest_path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, configparser.Error):
        return
    if not parser.has_section("options.entry_points"):
        return
    for _group, block in parser.items("options.entry_points"):
        for line in block.splitlines():
            _name, _eq, target = line.partition("=")
            entries.symbols.update(_symbols_from_target(target.strip()))


def collect_entry_points(root: Path, files: list[Path]) -> EntryPoints:
    entries = EntryPoints()
    for path in files:
        if path.name == "package.json":
            _package_json_entries(root, path, entries)
        elif path.name == "pyproject.toml":
            _pyproject_entries(path, entries)
        elif path.name == "setup.cfg":
            _setup_cfg_entries(path, entries)
    return entries


# ── Classification (the grep base — always runs, zero subprocesses) ────────


def _is_declaration_only(line: str) -> bool:
    """Lines a symbol name can appear on without being used: comments and
    `__all__` export declarations."""
    stripped = line.strip()
    return stripped.startswith(("#", "//", "*", "/*")) or "__all__" in line


def _entry_file_decision(hit: DefHit, record: FileRecord, entries: EntryPoints) -> tuple[str, str] | None:
    """Defs in a manifest entry file are flagged per spec, never usage-analyzed
    — the file runs as a whole. None when the file is not an entry point."""
    if record.relpath not in entries.files:
        return None
    if hit.marker_reason is not None:
        return "justified", hit.marker_reason
    return "safe-keep", "CLI/module entry point (package.json)"


def _safe_keep_decision(
    hit: DefHit, record: FileRecord, dyn_refs: set, entry_symbols: set[str], ignore_exported: bool = False
) -> tuple[str, str]:
    """The keep-class chain every row passes through — grep-classified and
    native-only alike. Marker wins; then structural safe-keeps; else candidate.
    `ignore_exported` is for tools that already model public entry points."""
    if hit.marker_reason is not None:
        return "justified", hit.marker_reason
    if hit.name in record.all_names or (hit.exported and not ignore_exported):
        return "safe-keep", "exported API"
    if hit.name == "main":
        return "safe-keep", "entry-point name 'main'"
    if hit.name in entry_symbols:
        return "safe-keep", "console-script entry point (pyproject.toml/setup.cfg)"
    if DUNDER_RE.match(hit.name):
        return "safe-keep", "dunder protocol method"
    if hit.registered:
        return "safe-keep", "registered via decorator/attribute"
    if dyn_refs:
        return "safe-keep", "dynamically referenced (getattr/import/require)"
    return "candidate", ""


def _reference_index(records: list[FileRecord]) -> tuple[dict, dict, dict]:
    """(identifier → files, dynamically-named identifier → files, relpath → record)."""
    index: dict[str, set[str]] = {}
    dynamic_index: dict[str, set[str]] = {}
    by_rel: dict[str, FileRecord] = {}
    for record in records:
        by_rel[record.relpath] = record
        for name in record.idents:
            index.setdefault(name, set()).add(record.relpath)
        for name in record.dynamic:
            dynamic_index.setdefault(name, set()).add(record.relpath)
    return index, dynamic_index, by_rel


def classify(records: list[FileRecord], entries: EntryPoints) -> list[dict]:
    index, dynamic_index, by_rel = _reference_index(records)
    rows: list[dict] = []
    for record in records:
        if TEST_PATH_RE.search(record.relpath):
            # Test files are harness code the runner invokes by name; skip their defs.
            continue
        for hit in record.defs:
            entry_decision = _entry_file_decision(hit, record, entries)
            if entry_decision is not None:
                rows.append(_row(hit, *entry_decision, False, []))
                continue
            cross = index.get(hit.name, set()) - {record.relpath}
            normal_refs = {rel for rel in cross if hit.name not in by_rel[rel].dynamic}
            dyn_refs = cross & dynamic_index.get(hit.name, set())
            references: list[dict] = []
            test_only = False
            if hit.self_used or any(not TEST_PATH_RE.search(rel) for rel in normal_refs):
                continue  # used by production code somewhere (or self) — not a finding
            if normal_refs:
                test_only = True  # only test-path files reference it repo-wide
                references = [
                    {"path": rel, "reason": "test"} for rel in sorted(normal_refs)
                ]

            keep_class, keep_reason = _safe_keep_decision(hit, record, dyn_refs, entries.symbols)
            rows.append(_row(hit, keep_class, keep_reason, test_only, references))
    return rows


def _row(hit: DefHit, keep_class: str, keep_reason: str, test_only: bool, references: list[dict]) -> dict:
    return {
        "symbol": hit.name,
        "kind": hit.kind,
        "path": hit.path,
        "line": hit.line,
        "keep_class": keep_class,
        "keep_reason": keep_reason,
        "note": hit.note,
        "detected_by": "grep",
        "test_only": test_only,
        "references": references,
    }


# ── Native tool adapters ────────────────────────────────────────────────────


VULTURE_RE = re.compile(r"^(.+?):(\d+): unused ([\w ]+?) '([^']+)' \(\d+% confidence\)")
VULTURE_KINDS = {
    "function": "function", "method": "method", "class": "class", "variable": "variable",
    "import": "import", "attribute": "attribute", "property": "attribute",
}
STATICCHECK_RE = re.compile(r"^(.+?):(\d+):\d+: (\w+) (\S+) is unused \(U1000\)")
STATICCHECK_KINDS = {
    "func": "function", "type": "type", "var": "variable", "const": "variable", "field": "attribute",
}


def parse_vulture(out: str) -> list[dict]:
    """`mod.py:4: unused function 'unused_fn' (60% confidence)` per finding."""
    rows = []
    for line in out.splitlines():
        m = VULTURE_RE.match(line.strip())
        if m and m.group(3) in VULTURE_KINDS:
            rows.append(
                {"symbol": m.group(4), "kind": VULTURE_KINDS[m.group(3)],
                 "path": m.group(1), "line": int(m.group(2)), "detected_by": "native:vulture"}
            )
    return rows


def parse_staticcheck(out: str) -> list[dict]:
    """`main.go:3:6: func unusedFn is unused (U1000)`; methods print with their
    receiver (`func (*T).m`), so the bare symbol is the last dotted segment."""
    rows = []
    for line in out.splitlines():
        m = STATICCHECK_RE.match(line.strip())
        if m and m.group(3) in STATICCHECK_KINDS:
            name = m.group(4)
            kind = "method" if name.startswith("(") else STATICCHECK_KINDS[m.group(3)]
            rows.append(
                {"symbol": name.rsplit(".", 1)[-1], "kind": kind,
                 "path": m.group(1), "line": int(m.group(2)), "detected_by": "native:staticcheck"}
            )
    return rows


def parse_knip(out: str) -> list[dict]:
    """knip's JSON reporter emits `{"issues": [{"file", "exports": [{"name",
    "line"}], "types": [...], ...}]}` — one object per file."""
    payload = json.loads(out)
    issues = payload.get("issues") if isinstance(payload, dict) else None
    if not isinstance(issues, list):
        raise ValueError("knip payload has no issues list")
    rows = []
    for file_issue in issues:
        file_field = file_issue.get("file") if isinstance(file_issue, dict) else None
        if not isinstance(file_field, str):
            raise ValueError("knip issue entry missing file")
        for field, kind in (("exports", "export"), ("types", "type")):
            for entry in file_issue.get(field) or []:
                if not isinstance(entry, dict) or not isinstance(entry.get("name"), str):
                    continue
                line = entry.get("line")
                rows.append(
                    {"symbol": entry["name"], "kind": kind, "path": file_field.removeprefix("./"),
                     "line": line if isinstance(line, int) else 0, "detected_by": "native:knip"}
                )
    return rows


def _has_python_sources(root: Path, records: list[FileRecord]) -> bool:
    return any(r.relpath.endswith((".py", ".pyi")) for r in records)


def _has_package_json(root: Path, records: list[FileRecord]) -> bool:
    return (root / "package.json").is_file()


def _has_go_mod(root: Path, records: list[FileRecord]) -> bool:
    return (root / "go.mod").is_file()


# vulture matches names, not bindings, so a re-export reads as unused; knip models
# entry points, so an export it lists is unused and its rows lose the exported safe-keep.
NAME_BASED_TOOLS = {"native:vulture"}
EXPORT_AWARE_TOOLS = {"native:knip"}


def _vulture_exclude_args(root: Path) -> list[str]:
    """vulture wraps a glob-free pattern as `*p*` and matches against the absolute
    path, so exclusions are globs anchored to the resolved root (an excluded name
    in an ancestor, e.g. `.claude/worktrees/`, must not match every file)."""
    base = glob.escape(str(root)).replace(",", "?")  # the list splits on "," before matching
    return ["--exclude", ",".join(f"{base}/*/{d}/*,{base}/{d}/*" for d in sorted(EXCLUDED_DIRS))]


class NativeTool(NamedTuple):
    argv: list[str]
    parser: Callable[[str], list[dict]]
    applicable: Callable[[Path, list[FileRecord]], bool]
    ok_codes: tuple[int, ...]  # findings are signalled by exit code, not failure
    extra_args: Callable[[Path], list[str]] | None = None  # root-dependent argv tail


# An installed-but-inapplicable tool (knip without package.json, …) is a
# designed skip like an absent one: no run, no warning, status stays "ok".
NATIVE_TOOLS: dict[str, NativeTool] = {
    "vulture": NativeTool(
        ["vulture", "."], parse_vulture, _has_python_sources, (0, 3), _vulture_exclude_args
    ),
    "staticcheck": NativeTool(
        ["staticcheck", "-checks", "U1000", "./..."], parse_staticcheck, _has_go_mod, (0, 1)
    ),
    "knip": NativeTool(["knip", "--reporter", "json"], parse_knip, _has_package_json, (0, 1)),
}


def run_native(root: Path, records: list[FileRecord], warnings: list) -> tuple[list[dict], bool]:
    """Run whichever native tools are installed and apply to this repo.
    Returns (rows, any_ran_ok)."""
    rows: list[dict] = []
    ran_ok = False
    for tool, (argv, parser, applicable, ok_codes, extra_args) in NATIVE_TOOLS.items():
        if shutil.which(argv[0]) is None or not applicable(root, records):
            continue
        try:
            proc = subprocess.run(
                argv + (extra_args(root) if extra_args else []),
                cwd=str(root), capture_output=True, text=True, timeout=120,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            warnings.append(_warning("native-error", f"{tool} failed: {exc}"))
            continue
        if proc.returncode not in ok_codes:
            warnings.append(
                _warning("native-error", f"{tool} exited {proc.returncode}: {proc.stderr.strip()[:200]}")
            )
            continue
        try:
            rows.extend(parser(proc.stdout))
            ran_ok = True
        except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
            warnings.append(_warning("native-error", f"{tool} output unparsable: {exc}"))
    return rows, ran_ok


def merge_native(rows: list[dict], native_rows: list[dict], records: list[FileRecord], entries: EntryPoints | None = None) -> list[dict]:
    """Merge native findings into grep-classified rows.

    Native-only findings go through classify()'s entry-point and safe-keep chain;
    test-path and excluded-dir findings are dropped. Defs match by (path, symbol),
    never name alone. Name-based vulture rows (imports aside) are checked against
    the text index too, since it misses re-exports; type-aware tools are trusted.
    """
    entries = entries or EntryPoints()
    index, dynamic_index, by_rel = _reference_index(records)
    by_key = {(r["path"], r["line"], r["symbol"]): r for r in rows}
    by_path_symbol: dict[tuple[str, str], dict] = {}
    for row in rows:
        by_path_symbol.setdefault((row["path"], row["symbol"]), row)
    record_defs: dict[tuple[str, str], tuple[DefHit, FileRecord]] = {}
    for record in records:
        if TEST_PATH_RE.search(record.relpath):
            continue
        for hit in record.defs:
            record_defs.setdefault((record.relpath, hit.name), (hit, record))

    def decide(hit: DefHit, record: FileRecord, tool: str) -> tuple[str, str]:
        dyn_refs = dynamic_index.get(hit.name, set()) - {record.relpath}
        return _safe_keep_decision(hit, record, dyn_refs, entries.symbols, ignore_exported=tool in EXPORT_AWARE_TOOLS)

    for native in native_rows:
        path, symbol = native["path"].removeprefix("./"), native["symbol"]
        if TEST_PATH_RE.search(path) or EXCLUDED_DIRS.intersection(Path(path).parts):
            continue
        key = (path, native["line"], symbol)
        existing = by_key.get(key) or by_path_symbol.get((path, symbol))
        if existing is not None:
            existing["detected_by"] = native["detected_by"]
            hit_record = record_defs.get((path, symbol))
            if (
                native["detected_by"] in EXPORT_AWARE_TOOLS
                and existing["keep_reason"] == "exported API"
                and hit_record is not None
            ):
                existing["keep_class"], existing["keep_reason"] = decide(*hit_record, native["detected_by"])
            continue
        test_only, references = False, []
        if native["detected_by"] in NAME_BASED_TOOLS and native["kind"] != "import":
            cross = index.get(symbol, set()) - {path}
            normal_refs = {rel for rel in cross if symbol not in by_rel[rel].dynamic}
            if any(not TEST_PATH_RE.search(rel) for rel in normal_refs):
                continue  # a production reference the tool can't see (e.g. a package re-export)
            if normal_refs:
                test_only = True
                references = [{"path": rel, "reason": "test"} for rel in sorted(normal_refs)]
        hit_record = record_defs.get((path, symbol))
        if hit_record is not None:
            hit, record = hit_record
            keep_class, keep_reason = (
                _entry_file_decision(hit, record, entries) or decide(hit, record, native["detected_by"])
            )
            note = hit.note
        else:
            keep_class, keep_reason, note = "candidate", "", ""
        row = {
            "symbol": symbol, "kind": native["kind"], "path": path, "line": native["line"],
            "keep_class": keep_class, "keep_reason": keep_reason, "note": note,
            "detected_by": native["detected_by"], "test_only": test_only, "references": references,
        }
        rows.append(row)
        by_key[key] = row
        by_path_symbol.setdefault((path, symbol), row)
    return rows


# ── LSP verification pass ───────────────────────────────────────────────────


def _lsp_bin() -> str:
    override = os.environ.get("SWB_DEAD_CODE_LSP_BIN")
    if override:
        return override
    return str(Path(__file__).resolve().parent / "swe-workbench-lsp")


def lsp_verify(root: Path, rows: list[dict], warnings: list) -> tuple[list[dict], bool]:
    """Verify candidates with swe-workbench-lsp callers; drop rows LSP proves used.

    Returns (rows, ran_ok). A missing server (exit 3) is the designed
    fallback — warning, keep grep results. A mid-scan error (exit 4/5) is
    degradation: warning, keep grep results, caller flips status to partial.
    """
    bin_path = _lsp_bin()
    verified = resolved = 0  # verified counts calls (the cap); resolved counts anchors the server answered
    for row in list(rows):  # snapshot: rows are removed mid-verification
        if row["keep_class"] != "candidate" or row["kind"] not in ("function", "method", "class"):
            continue
        if verified >= MAX_LSP_VERIFIES:
            warnings.append(_warning("lsp-cap", f"LSP verification capped at {MAX_LSP_VERIFIES} candidates"))
            break
        anchor = root / row["path"]
        try:
            proc = subprocess.run(
                [bin_path, "callers", f"{anchor}:{row['line']}", "--symbol", row["symbol"],
                 "--root", str(root), "--json"],
                capture_output=True, text=True, timeout=60,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            warnings.append(_warning("lsp-error", f"LSP verification failed: {exc}"))
            return rows, False
        verified += 1
        if proc.returncode == 3:
            warnings.append(_warning("lsp-unavailable", "no language server available; grep results stand"))
            return rows, False
        if proc.returncode != 0:
            warnings.append(
                _warning("lsp-error", f"lsp callers exited {proc.returncode}: {proc.stderr.strip()[:200]}")
            )
            return rows, False
        if not proc.stdout.lstrip().startswith("{"):
            continue  # an unresolved anchor prints plain text (exit 0): leave this row unverified
        try:
            payload = json.loads(proc.stdout)
            callers = payload.get("results", [])
        except json.JSONDecodeError:
            warnings.append(_warning("lsp-error", "lsp callers emitted unparsable JSON"))
            return rows, False
        resolved += 1
        caller_files = {c.get("file", "") for c in callers if isinstance(c, dict)}
        non_test = [f for f in caller_files if f and not TEST_PATH_RE.search(f)]
        if non_test:
            rows.remove(row)  # LSP found production callers the text index missed
        elif caller_files:
            row["test_only"] = True
            for f in sorted(caller_files):
                if not any(r["path"] == f for r in row["references"]):
                    row["references"].append({"path": f, "reason": "test"})
    return rows, resolved > 0


# ── Diff scope (--diff-from) ────────────────────────────────────────────────


class DiffError(ValueError):
    """The supplied diff text is not a unified diff the scope parser can follow."""


class Scope(NamedTuple):
    paths: list[str]  # changed files that carry hunks or a rename, in diff order
    added_lines: dict[str, set[int]]  # path → new-side line numbers of `+` lines
    removed_idents: set[str]  # identifiers on `-` lines of non-test source files


# Keywords and ubiquitous builtins would otherwise flood the watched set.
SCOPE_STOPLIST = frozenset({
    "self", "cls", "this", "None", "True", "False", "null", "undefined", "nil", "true", "false",
    "return", "def", "class", "function", "const", "let", "var", "if", "else", "elif", "for", "while",
    "in", "is", "not", "and", "or", "import", "from", "as", "with", "try", "except", "finally", "raise",
    "pass", "break", "continue", "yield", "async", "await", "new", "delete", "typeof", "void", "lambda",
    "global", "nonlocal", "assert", "print", "len", "str", "int", "float", "bool", "list", "dict", "set",
    "tuple", "range",
})

# A deleted comment line mentions a symbol without having called it.
COMMENT_LINE_STARTS = ("#", "//", "/*", "*")
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def _diff_path(raw: str, prefix: str) -> str | None:
    """A `---`/`+++` header path: drop the trailing tab (and any timestamp after
    it) and the default `a/`/`b/` prefix, then normalise; `/dev/null` (a created
    or deleted file) is no path. A C-quoted path (special or non-ASCII
    characters) stays quoted, so it names no file and surfaces as unresolved."""
    path = raw.split("\t", 1)[0].rstrip("\r")
    if path == "/dev/null":
        return None
    return posixpath.normpath(path.removeprefix(prefix))


def _tracks_removed_idents(path: str, root: Path | None) -> bool:
    """Removed identifiers count only from non-test source: not under an excluded
    dir (its references never count either), and extensionless only when the file
    on disk is a shebang script."""
    parts = Path(path).parts
    if Path(path).is_absolute() or ".." in parts or EXCLUDED_DIRS.intersection(parts) or TEST_PATH_RE.search(path):
        return False
    suffix = Path(path).suffix.lower()
    if suffix:
        return suffix in SOURCE_EXTS
    return root is not None and bool(_source_ext(root / path))


def derive_scope(diff_text: str, root: Path | None = None) -> Scope:
    """Added line numbers per file and the identifiers removed from non-test
    source code (comment-only lines aside), from unified diff text. Hunk line
    counts (not line prefixes) delimit hunk bodies, so a deleted `-- x` line is
    never mistaken for a `---` header. `root` lets extensionless paths be told
    apart as shebang scripts. Raises DiffError when the text is not a diff, is a
    combined diff, or a hunk is cut short."""
    lines = diff_text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    added: dict[str, set[int]] = {}
    removed: set[str] = set()
    old_path: str | None = None
    new_path: str | None = None
    binary = False
    recognised = False
    i = 0
    while i < len(lines):
        line = lines[i].rstrip("\r")
        i += 1
        if line.startswith(("diff --cc ", "diff --combined ")):
            raise DiffError("combined diffs are not supported")
        if line.startswith("diff --git "):
            old_path = new_path = None
            binary, recognised = False, True
        elif line.startswith("rename to "):
            new_path = posixpath.normpath(line[len("rename to "):])
            added.setdefault(new_path, set())
        elif line.startswith("--- "):
            old_path, new_path, binary, recognised = _diff_path(line[4:], "a/"), None, False, True
        elif line.startswith("+++ "):
            new_path, recognised = _diff_path(line[4:], "b/"), True
        elif line.startswith("Binary files ") or line == "GIT binary patch":
            binary = True
        elif (m := HUNK_RE.match(line)) is not None:
            recognised = True
            path = new_path or old_path  # a deleted file has no new path
            if binary or path is None:
                raise DiffError("hunk without a file header")
            added.setdefault(path, set())
            old_left = int(m.group(2)) if m.group(2) is not None else 1
            new_left = int(m.group(4)) if m.group(4) is not None else 1
            new_no = int(m.group(3))
            track = _tracks_removed_idents(path, root)
            while old_left > 0 or new_left > 0:
                if i >= len(lines):
                    raise DiffError("hunk ended before its declared length")
                body = lines[i].rstrip("\r")
                i += 1
                tag = body[:1]
                if tag == "\\":  # "\ No newline at end of file"
                    continue
                if tag == "+" and new_left > 0:
                    added[path].add(new_no)
                    new_no += 1
                    new_left -= 1
                elif tag == "-" and old_left > 0:
                    old_left -= 1
                    if track and not body[1:].lstrip().startswith(COMMENT_LINE_STARTS):
                        removed.update(t for t in IDENT_RE.findall(body[1:]) if t not in SCOPE_STOPLIST)
                elif (tag == " " or body == "") and old_left > 0 and new_left > 0:
                    new_no += 1
                    old_left -= 1
                    new_left -= 1
                else:
                    raise DiffError(f"unexpected line inside a hunk of {path}")
    if diff_text.strip() and not recognised:
        raise DiffError("no unified diff content recognised")
    return Scope(list(added), added, removed)


def _scan_file_scoped(
    rel: str, ext: str, text: str, watched: set[str], removed: set[str]
) -> FileRecord | None:
    """Reduce one unchanged file to what classification needs: which watched
    names it mentions (and names via dynamic lookups), plus full defs only when
    it defines a removed identifier. None when it mentions no watched name."""
    idents = set(IDENT_RE.findall(text))
    if idents & removed:
        record = parse_text(rel, ext, text)
        record.defs = [d for d in record.defs if d.name in removed]
        if record.defs:
            record.idents &= watched
            record.dynamic &= watched
            return record
    hits = idents & watched
    if not hits:
        return None
    record = FileRecord(rel)
    record.idents = hits
    if DYNAMIC_CALL_RE.search(text):
        for line in text.splitlines():
            if DYNAMIC_CALL_RE.search(line):
                record.dynamic.update(QUOTED_IDENT_RE.findall(line))
        record.dynamic &= hits
    return record


def _parse_changed(root: Path, scope: Scope, warnings: list) -> dict[str, FileRecord]:
    """Parse the diff's changed files that live inside `root`. A source path with
    added lines that resolves to no file there (a prefix the parser did not
    expect, a C-quoted name, a checkout that lacks the change, a symlink out of
    the root) is reported — silence would read as a clean scan."""
    changed: dict[str, FileRecord] = {}
    unresolved: list[str] = []
    for rel in scope.paths:
        parts = Path(rel).parts
        if EXCLUDED_DIRS.intersection(parts):
            continue
        path = root / rel
        inside = not Path(rel).is_absolute() and ".." not in parts and path.resolve().is_relative_to(root)
        if inside and path.is_file():
            record = parse_file(root, path)
            if record is not None:
                changed[record.relpath] = record
        elif scope.added_lines.get(rel) and Path(rel.rstrip('"')).suffix.lower() in SOURCE_EXTS:  # a quoted name ends in `"`
            unresolved.append(rel)
    if unresolved:
        shown = ", ".join(unresolved[:5]) + (f" (+{len(unresolved) - 5} more)" if len(unresolved) > 5 else "")
        warnings.append(
            _warning("diff-path-unresolved", f"{len(unresolved)} changed path(s) not found under the root: {shown}")
        )
    return changed


def scan_scoped(root: Path, scope: Scope, max_files: int, warnings: list) -> tuple[list[dict], int, int, int]:
    """Diff-scoped driver: (rows, scanned_files, scoped_paths, watched_symbols).

    Same classify()/safe-keep chain as the repo scan over a reduced index — the
    watched set is the names defined on `+` lines plus every removed identifier.
    A watched name's references are complete only while the walk stays under
    the file cap; changed files are always indexed, even past it."""
    changed = _parse_changed(root, scope, warnings)
    watched = set(scope.removed_idents)
    for record in changed.values():
        if not TEST_PATH_RE.search(record.relpath):
            added = scope.added_lines.get(record.relpath, ())
            watched.update(d.name for d in record.defs if d.line in added)
    if not watched:
        return [], len(changed), len(changed), 0  # nothing can be added or orphaned: skip the walk
    for record in changed.values():
        record.idents &= watched
        record.dynamic &= watched

    records = list(changed.values())
    manifests: list[Path] = []
    scanned = len(changed)
    for path in walk_files(root, max_files, warnings):
        if path.name in MANIFEST_NAMES:
            manifests.append(path)
            continue
        rel = path.relative_to(root).as_posix()
        ext = _source_ext(path)
        if rel in changed or not ext:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        scanned += 1
        record = _scan_file_scoped(rel, ext, text, watched, scope.removed_idents)
        if record is not None:
            records.append(record)

    rows: list[dict] = []
    for row in classify(records, collect_entry_points(root, manifests)):
        if row["line"] in scope.added_lines.get(row["path"], ()):
            row["diff_relation"] = "added"
        elif row["keep_class"] == "candidate" and row["symbol"] in scope.removed_idents:
            row["diff_relation"] = "orphaned"
        else:
            continue
        rows.append(row)
    return rows, scanned, len(changed), len(watched)


# ── Scan driver ─────────────────────────────────────────────────────────────


DEGRADED_CODES = {"file-cap", "lsp-error", "native-error", "diff-path-unresolved"}


def _envelope(
    rootp: Path, funnel: str, scanned: int, rows: list[dict], warnings: list[dict],
    scope: str = "repo", scoped_paths: int = 0, watched_symbols: int = 0,
) -> dict:
    for row in rows:
        row.setdefault("diff_relation", "")
    rows.sort(key=lambda r: (r["path"], r["line"], r["symbol"]))
    status = "partial" if any(w["code"] in DEGRADED_CODES for w in warnings) else "ok"
    return {
        "schema": SCHEMA,
        "status": status,
        "data": {
            "root": str(rootp),
            "funnel": funnel,
            "scanned_files": scanned,
            "candidate_count": sum(1 for r in rows if r["keep_class"] == "candidate"),
            "safe_keep_count": sum(1 for r in rows if r["keep_class"] == "safe-keep"),
            "justified_count": sum(1 for r in rows if r["keep_class"] == "justified"),
            "scope": scope,
            "scoped_paths": scoped_paths,
            "watched_symbols": watched_symbols,
            "candidates": rows,
        },
        "warnings": warnings,
    }


def scan_root(root: str, funnel: str = "auto", max_files: int = DEFAULT_MAX_FILES) -> dict:
    rootp = Path(root).resolve()
    warnings: list[dict] = []
    files = walk_files(rootp, max_files, warnings)
    records = [r for r in (parse_file(rootp, p) for p in files) if r]
    entries = collect_entry_points(rootp, files)
    rows = classify(records, entries)

    parts: list[str] = []
    if funnel in ("auto", "native"):
        native_rows, native_ran = run_native(rootp, records, warnings)
        if native_ran:
            parts.append("native")
        rows = merge_native(rows, native_rows, records, entries)
    if funnel in ("auto", "lsp"):
        rows, lsp_ran = lsp_verify(rootp, rows, warnings)
        if lsp_ran:
            parts.append("lsp")
    parts.append("grep")
    return _envelope(rootp, "+".join(parts), len(records), rows, warnings)


def scan_diff(root: str, scope: Scope, max_files: int = DEFAULT_MAX_SCOPED_FILES) -> dict:
    rootp = Path(root).resolve()
    warnings: list[dict] = []
    rows, scanned, scoped_paths, watched = scan_scoped(rootp, scope, max_files, warnings)
    return _envelope(rootp, "grep", scanned, rows, warnings, "diff", scoped_paths, watched)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="swe-workbench-dead-code-scan",
        description="Dead/test-only code scanner (read-only; emits the swb.dead-code-scan/1 envelope)",
    )
    parser.add_argument("--root", default=os.getcwd(), help="workspace root to scan (default: cwd)")
    parser.add_argument(
        "--funnel", choices=("auto", "native", "lsp", "grep"), default="auto",
        help="detection funnel: auto = native tools + LSP verification + text index; "
             "native/lsp force one stage; grep stays fully in-process",
    )
    parser.add_argument(
        "--max-files", type=int, default=None,
        help=f"cap on scanned source files (default {DEFAULT_MAX_FILES}; "
             f"{DEFAULT_MAX_SCOPED_FILES} with --diff-from)",
    )
    parser.add_argument(
        "--diff-from", metavar="PATH", default=None,
        help="unified diff text (a file path, or - for stdin) that scopes the scan: only rows whose "
             "definition sits on a + line, or whose name appears on a deleted non-test line, are "
             "emitted. Requires --funnel grep; the scanner itself never runs git",
    )
    args = parser.parse_args(argv)

    root = Path(args.root)
    if not root.is_dir():
        print(f"error: root is not a directory: {root}", file=sys.stderr)
        return 1
    if args.diff_from is not None:
        if args.funnel != "grep":
            print("error: --diff-from requires --funnel grep (native and LSP funnels are whole-repo)", file=sys.stderr)
            return 1
        try:
            raw = sys.stdin.buffer.read() if args.diff_from == "-" else Path(args.diff_from).read_bytes()
            scope = derive_scope(raw.decode("utf-8", errors="replace"), root.resolve())
        except OSError as exc:
            print(f"error: cannot read diff: {exc}", file=sys.stderr)
            return 1
        except DiffError as exc:
            print(f"error: malformed diff: {exc}", file=sys.stderr)
            return 1
        envelope = scan_diff(str(root), scope, max_files=DEFAULT_MAX_SCOPED_FILES if args.max_files is None else args.max_files)
    else:
        envelope = scan_root(str(root), funnel=args.funnel, max_files=DEFAULT_MAX_FILES if args.max_files is None else args.max_files)
    json.dump(envelope, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
