#!/usr/bin/env bash
# swe-workbench-repo-scope [--repo owner/repo | --pr-json <file>]
#
# Prints the normalized owner-repo slug that scopes /tmp/swe-workbench-*
# ephemeral artifacts by repository (convention documented in
# shared/docs/repo-scoped-ephemeral-state.md): owner/repo -> owner-repo,
# length-prefixed with owner's own length so the join stays injective while
# staying inside the [A-Za-z0-9._-] charset every other allowlist regex in
# this scheme already hardcodes (plain `tr '/' '-'`, the pre-existing
# workflow-audit-emit-issues convention, is NOT injective: 'acme-app/foo' and
# 'acme/app-foo' would both collapse to 'acme-app-foo').
#
# Tier S output (shared/docs/runtime-result-contract.md): the slug on stdout,
# nothing else. Unresolvable -> exit 1, empty stdout; callers treat an empty
# slug as "legacy un-scoped naming" (legacy behavior), never a failure of
# their own flow.
#
# Resolution ladder (first hit wins):
#   --repo owner/repo  explicit scope from the caller — the PR record in hand
#                      when the invocation carried a full PR URL
#   --pr-json <file>   slug read from the fetched PR JSON's own .url field
#                      (https://github.com/<owner>/<repo>/pull/<N>)
#   (no args)          `git remote get-url origin` of the cwd (https, git@,
#                      ssh:// forms; .git suffix tolerated)
#
# GitHub owner/repo names are [A-Za-z0-9._-]; the shape checks below reject
# anything else rather than guess. Owner must start alphanumeric (GitHub
# org/user names never start with '.', '-', or '_'); repo has no such
# restriction (GitHub allows e.g. the special ".github" repo) but must not
# be the traversal-shaped "." or "..".

set -euo pipefail

escape_owner_repo() {
  # Length-prefixes owner so the join is injective with NO escaping:
  # "<len(owner)>-<owner>-<repo>". Decoding (never actually done downstream
  # — the slug is opaque by design — but this is the proof of injectivity)
  # always terminates the leading digit run at the very next '-', which is
  # guaranteed present by construction; reading exactly that many
  # characters past it recovers owner byte-for-byte regardless of what
  # hyphens it or repo contain, and everything after the following '-' is
  # repo. A prior hyphen-doubling scheme was NOT actually injective — using
  # the same character as both the escape marker and the separator can't
  # distinguish "this hyphen is escaped" from "this hyphen starts the
  # separator run": owner='a-'/repo='b' and owner='a'/repo='-b' both
  # produced 'a---b'. See shared/docs/repo-scoped-ephemeral-state.md
  # § The slug.
  local owner="${1%%/*}" repo="${1#*/}"
  printf '%s-%s-%s\n' "${#owner}" "$owner" "$repo"
}

# _owner_repo_ok <owner/repo> — the single shared shape validator used by
# all three resolve_* functions below, so a candidate owner/repo pair is
# judged identically regardless of which resolution path produced it
# (resolve_pr_json/resolve_origin used to extract with a looser, owner-vs-repo-
# inconsistent regex than resolve_explicit's own check — this closes that gap).
_owner_repo_ok() {
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._-]+$' || return 1
  case "${1#*/}" in
    .|..) return 1 ;;
  esac
}

if [ $# -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
  exit 0
fi

MODE="${1:-}"
ARG="${2:-}"

resolve_explicit() {
  _owner_repo_ok "$1" || return 1
  escape_owner_repo "$1"
}

resolve_pr_json() {
  [ -f "$1" ] || return 1
  local url owner_repo
  url=$(jq -r '.url // empty' "$1" 2>/dev/null) || return 1
  [ -n "$url" ] || return 1
  owner_repo=$(printf '%s' "$url" | sed -nE 's#^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/pull/[0-9]+/?$#\1/\2#p')
  [ -n "$owner_repo" ] || return 1
  _owner_repo_ok "$owner_repo" || return 1
  escape_owner_repo "$owner_repo"
}

resolve_origin() {
  local url owner_repo
  url=$(git remote get-url origin 2>/dev/null) || return 1
  # GitHub forbids repo names ending in ".git", so pre-stripping the suffix is
  # unambiguous — and avoids the greedy-charset trap where [A-Za-z0-9._-]+
  # swallows ".git" before an optional (\.git)? group can claim it.
  url="${url%.git}"
  owner_repo=$(printf '%s' "$url" | sed -nE \
    -e 's#^https://[^/@]*github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/?$#\1/\2#p' \
    -e 's#^git@github\.com:([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)$#\1/\2#p' \
    -e 's#^ssh://git@github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)$#\1/\2#p')
  [ -n "$owner_repo" ] || return 1
  _owner_repo_ok "$owner_repo" || return 1
  escape_owner_repo "$owner_repo"
}

# Extra positionals after the recognized pair are a caller typo, not a wider
# scope — reject rather than silently succeed on a partial argument list.
[ "$#" -le 2 ] || {
  printf 'swe-workbench-repo-scope: unexpected extra argument(s)\n' >&2
  exit 1
}

case "$MODE" in
  --repo)
    [ -n "$ARG" ] || exit 1
    resolve_explicit "$ARG" && exit 0
    exit 1
    ;;
  --pr-json)
    [ -n "$ARG" ] || exit 1
    resolve_pr_json "$ARG" && exit 0
    exit 1
    ;;
  "")
    resolve_origin && exit 0
    exit 1
    ;;
  *)
    printf 'swe-workbench-repo-scope: unrecognized argument: %s\n' "$MODE" >&2
    exit 1
    ;;
esac
