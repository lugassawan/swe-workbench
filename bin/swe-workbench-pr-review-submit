#!/usr/bin/env python3
"""Posting mechanism for workflow-pr-review-post's `## Post` section (issue #550).

Fetches existing review threads, dedups a findings payload against them,
pre-validates inline anchors against the PR diff, posts pr-level batches,
applies the self-review + diff-scoping decision flip, and submits the
review — atomically when possible, with a bounded 422 retry and a
per-comment fallback when it isn't. This module owns the mechanism only;
the input contract, the Step 5 AskUserQuestion CTA (main-thread-only, can't
move into a script), and the failure-mode/common-mistakes documentation
stay in skills/workflow-pr-review-post/SKILL.md.

Prints one JSON envelope to stdout on success (schema `swb.pr-review-submit/1`, see
shared/docs/runtime-result-contract.md): `status` is "ok" when the review was
successfully submitted (by any of the atomic/retry/fallback paths) and "partial"
when every path was exhausted with nothing landed — the script still exits 0 either
way, since the caller's cleanup chain must never abort on a posting failure. An
input-contract validation failure (see `validate_payload`) exits 1 with no stdout at
all — never a partial envelope.

Comment bodies are rendered here, never by the caller: each --findings-json row
carries structured fields (`severity`, `issue`, `why`, `fix`, `anchor`, and optional
`path`/`line`/`category`) and render_finding() applies the one template —
`**<Sev>**[ · <Category>][ · `path:line`] — <issue>` / `**Why it matters:** <why>` /
`**Suggested fix:** <fix>`, one paragraph each. Rendering happens at post time, after
validate_lines() has settled each row's final anchor, so a row demoted from inline to
PR-level gets its `path:line` in the headline. A row carrying the old free-form `body`
is rejected: the payload is strict rather than silently accepting two shapes.

Atomicity and idempotency rationale (why this isn't a simple per-finding
loop): the GitHub Reviews API's POST .../pulls/{n}/reviews accepts a
comments[] array and posts the whole batch as one review in one call. That
buys atomicity (either every candidate lands with the review, or none do)
but costs debuggability — a single bad (path, line) 422s the entire batch,
and the error body carries no per-comment index to identify which row
failed. Steps 2's pre-validate pass exists to catch that class of error
before it can poison the batch; the 422 handler below exists for the
residual case (the diff moved between pre-validate and submit).

There is no idempotency key for this endpoint, so a client-side failure
(timeout, 5xx) is genuinely ambiguous — the POST may have landed
server-side even though the client never saw success. Blind-retrying would
double-post every comment in the batch on the ~50% of ambiguous failures
where it actually landed. Instead, an ambiguous failure triggers a cheap
read-your-write check (list reviews, filter by current user + head SHA)
before conceding to the per-comment ("model-A") fallback — this confirmation
requires --current-user to be known; with identity unknown (a valid,
documented state) the check can't filter by author and is skipped, the same
fail-open posture the pre-#550 bash carried. The one
*intentional* retry is scoped narrowly: a confirmed 422 (stale commit_id,
or a line that went out-of-diff between pre-validate and submit) is
re-validated against a freshly-fetched HEAD and retried exactly once.

Why `gh api` bracket-indexed field flags (-f "comments[0][path]=...") can't
build the comments[] payload: they build a JSON *object* keyed by
stringified indices ({"comments":{"0":{...}}}), not an array — GitHub's
Reviews API requires an array and rejects the object shape outright. This
module builds the payload as real Python data structures and serializes it
once with json.dumps, which sidesteps that failure mode entirely (see
shared/docs/gh-api-field-flags.md for the shell-side version of this pitfall, and
shared/docs/shell-echo-vs-printf.md for the related `echo`-corrupts-JSON hazard —
neither applies here since no shell ever sees this payload as a string to
re-interpret).

All `gh` calls funnel through _gh()/_gh_json(), which dispatch to the
sibling swe-workbench-gh-timeout script (resolved via Path(__file__).parent,
the Python equivalent of the bin/ dirname "$0" convention) rather than a
bare PATH lookup, so every network call inherits gh-timeout's per-call
deadline — including gh pr diff, which the prior hand-written prose called
unwrapped.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

REMARK_TEXT = "([swe-workbench](https://github.com/lugassawan/swe-workbench))"
JACCARD_THRESHOLD = 0.4
LINE_FUZZ = 5

_STOPWORDS_MIN_LEN = 1


# ── Pure helpers ─────────────────────────────────────────────────────────────


def tokenize(text: str) -> set[str]:
    return {w for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", (text or "").lower()) if len(w) > _STOPWORDS_MIN_LEN}


def jaccard(a: str, b: str) -> float:
    ta, tb = tokenize(a), tokenize(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


@dataclass
class Thread:
    id: str
    path: str
    line: int
    is_resolved: bool
    head_comment_id: str | None
    head_comment_body: str
    reactor_logins: set[str] = field(default_factory=set)
    is_outdated: bool = False


def _label_pattern(label: str) -> str:
    """Bold or plain form of a `label:` — `**Label:**`, `**Label**:`, `Label:`."""
    return r"\*{0,2}" + label + r"(?:\s*:\s*\*{0,2}|\s*\*{0,2}\s*:)"


_WHY_LABEL_RE = re.compile(r"^\s*" + _label_pattern("why it matters") + r"\s*", re.IGNORECASE)
_FIX_LABEL_RE = re.compile(r"^\s*" + _label_pattern("suggested fix") + r"\s*", re.IGNORECASE)
_ANY_LABEL_RE = re.compile(_label_pattern("(?:why it matters|suggested fix)"), re.IGNORECASE)
# Leading `**Severity**[ · Category][ · `path:line`] — ` headline. The dash is optional so a
# pre-template body like "**High** text" still loses its severity token.
_HEADLINE_RE = re.compile(r"^\s*\*\*[^*\n]+\*\*(?:\s*·\s*[^·—\n]+)*(?:\s*—\s*)?")


def _strip_label(label_re: re.Pattern, text: str) -> str:
    return label_re.sub("", text, count=1).strip()


def render_finding(row: dict, pr_level: bool) -> str:
    """The one comment template. Callers pass fields, never prose layout.

    A `why`/`fix` that already carries its own label is stripped rather than
    doubled. `path:line` joins the headline only for pr-level rendering — an
    inline comment is already anchored to its line."""
    headline = f"**{_clean_severity(row['severity'])}**"
    category = (row.get("category") or "").strip()
    if category:
        headline += f" · {category}"
    path = row.get("path")
    if pr_level and path:
        line = row.get("line")
        headline += f" · `{path}:{line}`" if line else f" · `{path}`"
    headline += f" — {row['issue'].strip()}"
    why = _labelled("Why it matters", _strip_label(_WHY_LABEL_RE, row["why"]))
    fix = _labelled("Suggested fix", _strip_label(_FIX_LABEL_RE, row["fix"]))
    return f"{headline}\n\n{why}\n\n{fix}"


def _clean_severity(severity: str) -> str:
    """A caller-supplied `**High**` must not render as `****High****`."""
    return severity.strip().strip("*").strip()


def _labelled(label: str, text: str) -> str:
    """`**Label:** text` — but a value opening with a code fence goes on its own paragraph:
    GitHub only starts a fence at the beginning of a line, so a mid-line ```suggestion
    would print as literal text and forfeit the one-click suggestion."""
    sep = "\n\n" if text.startswith(("```", "~~~")) else " "
    return f"**{label}:**{sep}{text}"


def dedup_text(text: str) -> str:
    """Strip presentation so Jaccard compares content only: the headline
    severity/category/`path:line` prefix and both label forms. Without this every
    templated comment shares ~6 label tokens and unrelated findings false-dedup;
    it also maps pre-template run-on threads into the same token space."""
    return _ANY_LABEL_RE.sub(" ", _HEADLINE_RE.sub("", text or "", count=1))


def thread_matches(finding_path: str, finding_line: int, finding_body: str, thread: Thread) -> bool:
    """`finding_body` is the rendered comment; both sides go through dedup_text."""
    if thread.is_resolved:
        return False
    if thread.path != finding_path:
        return False
    if thread.line < 0 or abs(thread.line - finding_line) > LINE_FUZZ:
        return False
    return jaccard(dedup_text(finding_body), dedup_text(thread.head_comment_body)) >= JACCARD_THRESHOLD


def blocking_threads(threads: list[Thread]) -> list[Thread]:
    """Unresolved, non-outdated threads block APPROVE: any severity — GitHub
    review threads carry no severity field, and a reviewer's severity label isn't
    durable across runs. isResolved/isOutdated are the only release valves."""
    return [t for t in threads if not t.is_resolved and not t.is_outdated]


def build_byline(byline: str, is_private: bool | None, n_inline: int, posted_pr_level: int, deduped: int) -> str:
    remark = REMARK_TEXT if is_private is False else ""
    return f"{byline}{remark}. Posted {n_inline} inline comment(s) and {posted_pr_level} PR-level note(s), deduped {deduped}."


def build_summary(
    decision: str, byline_full: str, is_self_review: bool, override_note: str | None = None, n_blocking: int = 0
) -> str:
    if is_self_review:
        return f"{byline_full}\n"
    summary = f"**Review Decision: {decision}**\n\n{byline_full}\n"
    if override_note is not None:
        summary += f"\n_Approved with {n_blocking} unresolved review thread(s) still open — override: {override_note}._\n"
    return summary


def resolve_event(
    decision: str,
    blocking_scope: str,
    current_user: str,
    author_login: str,
    n_blocking_threads: int = 0,
    override: bool = False,
) -> tuple[str, str, bool, bool]:
    """Returns (event, decision, is_self_review, identity_known)."""
    identity_known = bool(current_user) and bool(author_login)
    is_self_review = identity_known and current_user == author_login
    if decision == "COMMENT" and blocking_scope == "OUT-OF-DIFF-ONLY" and identity_known and not is_self_review:
        decision = "APPROVE"
    if decision == "APPROVE" and n_blocking_threads > 0 and not (override and not is_self_review):
        decision = "COMMENT"
    event = "COMMENT" if is_self_review else decision
    return event, decision, is_self_review, identity_known


def partition_findings(findings: list[dict]) -> tuple[list[dict], list[dict]]:
    inline = [f for f in findings if f.get("anchor") == "inline"]
    pr_level = [f for f in findings if f.get("anchor") == "pr-level"]
    return inline, pr_level


# ── gh layer ─────────────────────────────────────────────────────────────────


class PostingError(Exception):
    pass


def _script_dir() -> Path:
    return Path(__file__).resolve().parent


def _check_siblings(script_dir: Path) -> None:
    """Loud, actionable failure on a corrupted install — mirrors the `command -v ... ||
    { echo reinstall or update ...; exit 1; }` preflight every other bin/ script uses,
    adapted for sibling resolution via Path(__file__).parent rather than PATH lookup."""
    for name in ("swe-workbench-gh-timeout", "swe-workbench-diff-line-lookup"):
        path = script_dir / name
        if not (path.is_file() and os.access(path, os.X_OK)):
            raise PostingError(
                f"sibling script {name} not found at {path} — reinstall or update the swe-workbench plugin."
            )


def _gh(args: list[str], input_data: str | None = None) -> subprocess.CompletedProcess:
    cmd = ["bash", str(_script_dir() / "swe-workbench-gh-timeout"), *args]
    # Always pass a (possibly empty) string so subprocess pipes and immediately closes
    # stdin, rather than inheriting the parent's — an inherited pipe with no EOF would
    # hang any call gh doesn't itself need stdin for.
    return subprocess.run(cmd, input=input_data if input_data is not None else "", capture_output=True, text=True)


def _gh_json(args: list[str], input_data: str | None = None):
    """Returns (data, proc) — data is None on non-zero exit or unparseable stdout."""
    proc = _gh(args, input_data=input_data)
    if proc.returncode != 0:
        return None, proc
    try:
        return json.loads(proc.stdout), proc
    except (json.JSONDecodeError, ValueError):
        return None, proc


# ── Step 1 — fetch existing review threads (paginated) ────────────────────────

_THREADS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $after) {
        pageInfo { endCursor hasNextPage }
        nodes {
          id isResolved isOutdated path line startLine
          comments(first: 10) {
            nodes {
              id databaseId body
              author { login }
              reactions(first: 20, content: THUMBS_UP) {
                nodes { user { login } }
              }
            }
          }
        }
      }
    }
  }
}
"""


def _thread_from_node(node: dict) -> Thread:
    comments = (node.get("comments") or {}).get("nodes") or []
    head = comments[0] if comments else None
    reactors: set[str] = set()
    if head:
        for r in (head.get("reactions") or {}).get("nodes") or []:
            login = ((r or {}).get("user") or {}).get("login")
            if login:
                reactors.add(login)
    start_line = node.get("startLine")
    line = node.get("line")
    effective_line = start_line if start_line is not None else line
    return Thread(
        id=node["id"],
        path=node.get("path") or "",
        line=effective_line if effective_line is not None else -1,
        is_resolved=bool(node.get("isResolved")),
        head_comment_id=(head or {}).get("id"),
        head_comment_body=(head or {}).get("body") or "",
        reactor_logins=reactors,
        is_outdated=bool(node.get("isOutdated")),
    )


def fetch_threads(owner: str, repo: str, pr: str) -> list[Thread]:
    threads: list[Thread] = []
    after: str | None = None
    while True:
        args = [
            "api", "graphql",
            "-F", f"number={pr}", "-F", f"owner={owner}", "-F", f"repo={repo}",
            "-f", f"query={_THREADS_QUERY}",
        ]
        if after:
            args += ["-F", f"after={after}"]
        data, proc = _gh_json(args)
        if data is None:
            raise PostingError(f"failed to fetch review threads: {proc.stderr.strip() or proc.stdout.strip()}")
        try:
            rt = data["data"]["repository"]["pullRequest"]["reviewThreads"]
        except (KeyError, TypeError) as exc:
            raise PostingError(f"unexpected reviewThreads response shape: {exc}") from exc
        for node in rt.get("nodes") or []:
            threads.append(_thread_from_node(node))
        page = rt.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        after = page.get("endCursor")
    return threads


# ── Step 2 — dedup + react, pre-validate, assemble ─────────────────────────────

_REACTION_MUTATION = """
mutation($subjectId: ID!) {
  addReaction(input: {subjectId: $subjectId, content: THUMBS_UP}) { reaction { id } }
}
"""


def dedup_and_react(threads: list[Thread], inline_findings: list[dict], current_user: str) -> tuple[list[dict], int]:
    survivors: list[dict] = []
    deduped = 0
    for finding in inline_findings:
        rendered = render_finding(finding, pr_level=False)
        match = next(
            (t for t in threads if thread_matches(finding["path"], finding["line"], rendered, t)),
            None,
        )
        if match is None:
            survivors.append(finding)
            continue
        deduped += 1
        if current_user and match.head_comment_id and current_user not in match.reactor_logins:
            _gh(["api", "graphql", "-F", f"subjectId={match.head_comment_id}", "-f", f"query={_REACTION_MUTATION}"])
    return survivors, deduped


def _git_show_line(head_sha: str, path: str, line: int) -> str | None:
    proc = subprocess.run(["git", "show", f"{head_sha}:{path}"], capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    lines = proc.stdout.splitlines()
    if line < 1 or line > len(lines):
        return None
    content = lines[line - 1]
    return content if content else None


def _line_is_in_diff(path: str, line: int, head_sha: str, pr_diff: str, script_dir: Path) -> bool:
    if not isinstance(line, int) or line < 1:
        return False
    content = _git_show_line(head_sha, path, line)
    if not content:
        return False
    proc = subprocess.run(
        ["bash", str(script_dir / "swe-workbench-diff-line-lookup"), path, content, "--stdin"],
        input=pr_diff, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return False
    return proc.stdout.strip() == f"{path}:{line}"


def _fetch_pr_diff(pr: str) -> str:
    """Loud, actionable failure — an empty diff from a failed/timed-out call would otherwise
    flow silently into validate_lines and demote every inline finding to one pr-level comment,
    with no error and no stderr warning."""
    proc = _gh(["pr", "diff", str(pr)])
    if proc.returncode != 0:
        raise PostingError(f"failed to fetch PR diff: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout


def _refetch_pr_diff(pr: str, stale_pr_diff: str) -> str:
    """Best-effort refetch for the 422-retry path: re-validating against a stale diff after a
    stale-commit_id 422 is the exact bug this exists to fix, but a refetch failure here is a
    degraded retry, not a foundational one — fall back to the stale diff (no worse than before
    this fix) rather than aborting an in-flight submission."""
    proc = _gh(["pr", "diff", str(pr)])
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        print(f"[warn] PR diff re-fetch failed during 422 retry — reusing the pre-retry diff: {detail}", file=sys.stderr)
        return stale_pr_diff
    return proc.stdout


def validate_lines(survivors: list[dict], pr_diff: str, head_sha: str, script_dir: Path) -> tuple[list[dict], list[dict]]:
    """Returns (still_in_diff, demoted_to_pr_level)."""
    in_diff: list[dict] = []
    demoted: list[dict] = []
    for finding in survivors:
        if _line_is_in_diff(finding["path"], finding["line"], head_sha, pr_diff, script_dir):
            in_diff.append(finding)
        else:
            demoted.append(finding)
    return in_diff, demoted


def post_pr_level(pr: str, findings: list[dict]) -> int:
    if not findings:
        return 0
    body = "\n\n---\n\n".join(render_finding(f, pr_level=True) for f in findings)
    proc = _gh(["pr", "comment", str(pr), "--body", body])
    if proc.returncode == 0:
        return len(findings)
    print(
        f"[warn] gh pr comment failed — pr-level batch of {len(findings)} finding(s) NOT posted.",
        file=sys.stderr,
    )
    return 0


# ── Step 4 — submit ─────────────────────────────────────────────────────────


@dataclass
class SubmitResult:
    posted_inline: int
    posted_pr_level: int
    submitted: bool
    review_url: str


def _extract_review_url(stdout: str) -> str:
    try:
        data = json.loads(stdout)
    except (json.JSONDecodeError, ValueError):
        return ""
    return data.get("html_url") or "" if isinstance(data, dict) else ""


def _landed_review_url(owner: str, repo: str, pr: str, current_user: str, head_sha: str) -> str | None:
    if not current_user:
        return None
    data, _proc = _gh_json(["api", f"repos/{owner}/{repo}/pulls/{pr}/reviews"])
    if not isinstance(data, list):
        return None
    matches = [
        r for r in data
        if (r.get("user") or {}).get("login") == current_user and r.get("commit_id") == head_sha
    ]
    if not matches:
        return None
    return matches[-1].get("html_url") or ""


def _post_review(owner: str, repo: str, pr: str, head_sha: str, event: str, body: str, comments: list[dict] | None):
    payload = {"commit_id": head_sha, "event": event, "body": body}
    if comments:
        payload["comments"] = comments
    return _gh(
        ["api", "--method", "POST", f"repos/{owner}/{repo}/pulls/{pr}/reviews", "--input", "-"],
        input_data=json.dumps(payload),
    )


def _inline_comment(finding: dict) -> dict:
    return {
        "path": finding["path"], "line": finding["line"], "side": "RIGHT",
        "body": render_finding(finding, pr_level=False),
    }


def submit_review(
    *, owner: str, repo: str, pr: str, head_sha: str, event: str,
    findings: list[dict], summary_fn, current_user: str, posted_pr_level: int,
    pr_diff: str, script_dir: Path,
) -> SubmitResult:
    """summary_fn(n_inline, posted_pr_level) -> review body text.

    Takes structured rows, not rendered comments: a row demoted mid-submit (422 retry,
    per-comment fallback) must re-render as PR-level with its path:line in the headline."""
    comments = [_inline_comment(f) for f in findings]
    n = len(comments)
    posted_inline = 0
    submitted = False
    review_url = ""

    if n > 0:
        # Atomic path: one POST carrying every candidate comment plus the review event/body.
        proc = _post_review(owner, repo, pr, head_sha, event, summary_fn(n, posted_pr_level), comments)
        if proc.returncode == 0:
            posted_inline, submitted, review_url = n, True, _extract_review_url(proc.stdout)
        elif "422" in (proc.stdout + proc.stderr):
            # Confirmed 422 (stale commit_id, or a line pre-validate missed): re-fetch HEAD and
            # the PR diff together, genuinely re-validate every comment against both, demote
            # anything now out-of-diff into the pr-level batch, then retry the atomic POST
            # exactly once. Re-fetching only head_sha while re-validating file content against
            # it but line-position against the stale diff text would defeat the point of this
            # retry — the diff moving is exactly the scenario it exists to handle.
            new_head_data, _p = _gh_json(["pr", "view", str(pr), "--json", "headRefOid"])
            head_sha = (new_head_data or {}).get("headRefOid") or head_sha
            pr_diff = _refetch_pr_diff(pr, pr_diff)
            still_in_diff, newly_demoted = [], []
            for f in findings:
                if _line_is_in_diff(f["path"], f["line"], head_sha, pr_diff, script_dir):
                    still_in_diff.append(f)
                else:
                    newly_demoted.append(f)
            if newly_demoted:
                posted_pr_level += post_pr_level(pr, newly_demoted)
            findings = still_in_diff
            comments = [_inline_comment(f) for f in findings]
            n = len(comments)
            if n > 0:
                proc2 = _post_review(owner, repo, pr, head_sha, event, summary_fn(n, posted_pr_level), comments)
                if proc2.returncode == 0:
                    posted_inline, submitted, review_url = n, True, _extract_review_url(proc2.stdout)
                else:
                    # Retry failed too (double-422, or network/5xx one level deeper) — same
                    # ambiguous-failure class as below, so reuse the read-your-write check
                    # before conceding to the model-A fallback.
                    landed = _landed_review_url(owner, repo, pr, current_user, head_sha)
                    if landed is not None:
                        posted_inline, submitted, review_url = n, True, landed
        else:
            # Network/5xx: no idempotency key on this endpoint, so a blind retry risks
            # double-posting a POST that actually landed server-side. Confirm via a
            # read-your-write check (list reviews, filter by current user + head SHA) instead.
            landed = _landed_review_url(owner, repo, pr, current_user, head_sha)
            if landed is not None:
                posted_inline, submitted, review_url = n, True, landed

    if not submitted:
        # Reached when N==0 (today's plain submit), OR the atomic POST 422'd twice, OR it
        # failed on network/5xx with no confirmed landing — model-A per-comment fallback.
        posted_inline = 0
        demoted: list[dict] = []
        for f in findings:
            c = _inline_comment(f)
            proc = _gh([
                "api", f"repos/{owner}/{repo}/pulls/{pr}/comments",
                "-f", f"body={c['body']}",
                "-F", f"path={c['path']}",
                "-F", f"line={c['line']}",
                "-F", "side=RIGHT",
                "-F", f"commit_id={head_sha}",
            ])
            if proc.returncode == 0:
                posted_inline += 1
            else:
                demoted.append(f)  # never dropped silently — folds into one follow-up pr-level comment
        if demoted:
            posted_pr_level += post_pr_level(pr, demoted)
        proc = _post_review(owner, repo, pr, head_sha, event, summary_fn(posted_inline, posted_pr_level), None)
        if proc.returncode == 0:
            submitted, review_url = True, _extract_review_url(proc.stdout)

    return SubmitResult(posted_inline=posted_inline, posted_pr_level=posted_pr_level, submitted=submitted, review_url=review_url)


def _repo_is_private(owner: str, repo: str) -> bool | None:
    data, _proc = _gh_json(["repo", "view", f"{owner}/{repo}", "--json", "isPrivate"])
    if not isinstance(data, dict):
        return None
    val = data.get("isPrivate")
    return val if isinstance(val, bool) else None


# ── Input contract validation ───────────────────────────────────────────────

_BLOCKING_SCOPES = ("NONE", "OUT-OF-DIFF-ONLY", "IN-DIFF")


def _remark_problem(text: str) -> str | None:
    return "must not embed the swe-workbench remark" if REMARK_TEXT in text else None


def _byline_problem(byline: str) -> str | None:
    problem = _remark_problem(byline)
    if problem:
        return problem
    if re.search(r"(?i)\bposted\b", byline) or re.search(r"(?i)\bdeduped\b", byline):
        return "must not embed posted/deduped counts"
    return None


_HEADLINE_FIELDS = ("severity", "issue")  # single-line: they build the comment headline
_BODY_FIELDS = ("why", "fix")  # may span lines (code fences)
_LINE_BREAK_RE = re.compile(r"[\r\n]")
_PATH_UNSAFE_RE = re.compile(r"[\r\n`]")


def _is_positive_int(value) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def _finding_problem(row) -> tuple[str, str] | None:
    """Returns (field, problem) — field is "" for a whole-row problem."""
    if not isinstance(row, dict):
        return "", "each row must be a JSON object"
    if "body" in row:
        return "body", "is no longer accepted — pass issue/why/fix and the script renders the comment body"
    for name in _HEADLINE_FIELDS + _BODY_FIELDS:
        value = row.get(name)
        if not isinstance(value, str):
            return name, "must be a non-empty string"
        if name == "severity":
            value = _clean_severity(value)
        elif name == "why":
            value = _strip_label(_WHY_LABEL_RE, value)
        elif name == "fix":
            value = _strip_label(_FIX_LABEL_RE, value)
        if not value.strip():
            return name, "must be a non-empty string"
        if name in _HEADLINE_FIELDS and _LINE_BREAK_RE.search(value.strip()):
            return name, "must be a single line"
    category = row.get("category")
    if category is not None:
        if not isinstance(category, str):
            return "category", "must be a string"
        if _LINE_BREAK_RE.search(category.strip()):
            return "category", "must be a single line"
    for name in ("severity", "issue", "why", "fix", "category", "path"):
        if isinstance(row.get(name), str) and REMARK_TEXT in row[name]:
            return name, "must not embed the swe-workbench remark — the byline/remark is a review-level concern only"
    anchor = row.get("anchor")
    if anchor not in ("inline", "pr-level"):
        return "anchor", "must be 'inline' or 'pr-level'"
    path, line = row.get("path"), row.get("line")
    if anchor == "inline":
        if not isinstance(path, str) or not path.strip():
            return "path", "is required (non-empty) for inline rows"
        if not _is_positive_int(line):
            return "line", "must be a positive integer for inline rows"
    elif path is not None and not isinstance(path, str):
        return "path", "must be a string when given"
    if isinstance(path, str) and _PATH_UNSAFE_RE.search(path):
        # An inline row can be demoted to pr-level, where the path lands in a code span.
        return "path", "must be a single line without backticks"
    if anchor == "pr-level":
        if path is not None and not path.strip():
            return "path", "must be non-empty when given"
        if line is not None and not _is_positive_int(line):
            return "line", "must be a positive integer when given"
        if line is not None and path is None:
            return "line", "requires path"
    return None


def validate_payload(args) -> tuple[list[dict] | None, tuple[str, str] | None]:
    """Returns (findings, error) — error is a (field, problem) tuple, or None on success."""
    if not re.match(r"^[^/\s]+/[^/\s]+$", args.repo or ""):
        return None, ("--repo", "must be in the form owner/repo")
    if not re.match(r"^[1-9][0-9]*$", args.pr or ""):
        return None, ("--pr", "must match [1-9][0-9]*")
    if not re.match(r"^[0-9a-fA-F]{40}$", args.head_sha or ""):
        return None, ("--head-sha", "must be a 40-character git SHA")
    if not args.base:
        return None, ("--base", "must be non-empty")
    if args.decision not in ("APPROVE", "COMMENT"):
        return None, ("--decision", "must be APPROVE or COMMENT")
    if not args.byline:
        return None, ("--byline", "must be non-empty")
    problem = _byline_problem(args.byline)
    if problem:
        return None, ("--byline", problem)
    if not args.caller_tag:
        return None, ("--caller-tag", "must be non-empty")
    if args.blocking_scope not in _BLOCKING_SCOPES:
        return None, ("--blocking-scope", f"must be one of {', '.join(_BLOCKING_SCOPES)}")
    for field_name, value in (("--current-user", args.current_user), ("--author-login", args.author_login)):
        if value and not re.match(r"^[^\s]+$", value):
            return None, (field_name, "must be a plain login string")
    if args.approve_over_open_threads:
        reason = args.approve_over_open_threads
        if "\n" in reason:
            return None, ("--approve-over-open-threads", "must be a single line")
        if len(reason) > 200:
            return None, ("--approve-over-open-threads", "must be at most 200 characters")
        problem = _remark_problem(reason)
        if problem:
            return None, ("--approve-over-open-threads", problem)

    try:
        raw = sys.stdin.read() if args.findings_json == "-" else Path(args.findings_json).read_text()
    except OSError as exc:
        return None, ("--findings-json", f"could not read file ({exc})")
    try:
        findings = json.loads(raw)
    except (json.JSONDecodeError, ValueError) as exc:
        return None, ("--findings-json", f"invalid JSON ({exc})")
    if not isinstance(findings, list):
        return None, ("--findings-json", "must be a JSON array")
    for i, row in enumerate(findings):
        found = _finding_problem(row)
        if found:
            name, problem = found
            return None, (f"--findings-json[{i}]" + (f".{name}" if name else ""), problem)

    return findings, None


# ── CLI ──────────────────────────────────────────────────────────────────────


def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="swe-workbench-pr-review-submit")
    p.add_argument("--repo", required=True)
    p.add_argument("--pr", required=True)
    p.add_argument("--head-sha", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--decision", required=True)
    p.add_argument("--byline", required=True)
    p.add_argument("--caller-tag", required=True)
    p.add_argument("--findings-json", required=True)
    p.add_argument("--blocking-scope", default="IN-DIFF")
    p.add_argument("--current-user", default="")
    p.add_argument("--author-login", default="")
    p.add_argument("--approve-over-open-threads", default="")
    p.add_argument("--debug-dir", default=None)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_arg_parser().parse_args(argv)

    findings, error = validate_payload(args)
    if error is not None:
        field_name, problem = error
        print(f"workflow-pr-review-post: invalid payload — {field_name} {problem}. Refusing to post.", file=sys.stderr)
        return 1

    owner, repo = args.repo.split("/", 1)
    inline_findings, pr_level_findings = partition_findings(findings)
    script_dir = _script_dir()

    try:
        _check_siblings(script_dir)
        threads = fetch_threads(owner, repo, args.pr)
        survivors, deduped = dedup_and_react(threads, inline_findings, args.current_user)

        pr_diff = _fetch_pr_diff(args.pr)
        in_diff, demoted = validate_lines(survivors, pr_diff, args.head_sha, script_dir)

        posted_pr_level = post_pr_level(args.pr, pr_level_findings + demoted)

        n_blocking = len(blocking_threads(threads))
        override = bool(args.approve_over_open_threads)
        event, decision, is_self_review, _identity_known = resolve_event(
            args.decision, args.blocking_scope, args.current_user, args.author_login, n_blocking, override=override,
        )
        _, decision_without_gate, _, _ = resolve_event(
            args.decision, args.blocking_scope, args.current_user, args.author_login, override=False,
        )
        override_used = override and n_blocking > 0 and not is_self_review and decision == "APPROVE"
        if n_blocking > 0 and decision_without_gate == "APPROVE" and decision != "APPROVE" and not override_used:
            print(
                f"[info] APPROVE downgraded to {decision} — {n_blocking} unresolved review "
                "thread(s) still open, blocking approval.",
                file=sys.stderr,
            )
        override_note = args.approve_over_open_threads if override_used else None
        is_private = _repo_is_private(owner, repo)

        def summary_fn(n_inline: int, pr_level_count: int) -> str:
            byline_full = build_byline(args.byline, is_private, n_inline, pr_level_count, deduped)
            return build_summary(decision, byline_full, is_self_review, override_note=override_note, n_blocking=n_blocking)

        result = submit_review(
            owner=owner, repo=repo, pr=args.pr, head_sha=args.head_sha, event=event,
            findings=in_diff, summary_fn=summary_fn, current_user=args.current_user,
            posted_pr_level=posted_pr_level, pr_diff=pr_diff, script_dir=script_dir,
        )
    except PostingError as exc:
        print(f"workflow-pr-review-post: {exc}", file=sys.stderr)
        return 1

    if args.debug_dir:
        debug_dir = Path(args.debug_dir)
        debug_dir.mkdir(parents=True, exist_ok=True)
        (debug_dir / f"{args.caller_tag}-threads.json").write_text(
            json.dumps([t.__dict__ for t in threads], default=list, indent=2)
        )
        (debug_dir / f"{args.caller_tag}-payload.json").write_text(
            json.dumps([_inline_comment(f) for f in in_diff], indent=2)
        )

    envelope = {
        "schema": "swb.pr-review-submit/1",
        "status": "ok" if result.submitted else "partial",
        "data": {
            "posted_inline": result.posted_inline,
            "posted_pr_level": result.posted_pr_level,
            "deduped": deduped,
            "submitted": result.submitted,
            "event": event,
            "decision": decision,
            "review_url": result.review_url,
            "blocked_by_unresolved": n_blocking,
            "approve_over_open_threads": bool(args.approve_over_open_threads),
            "override_reason": args.approve_over_open_threads,
        },
        "warnings": [],
    }
    json.dump(envelope, sys.stdout, ensure_ascii=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
