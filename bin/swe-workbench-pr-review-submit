#!/usr/bin/env python3
"""Posting mechanism for workflow-pr-review-post's `## Post` section.

Fetches existing review threads, earlier reviews and issue comments, dedups a findings
payload against all of them, pre-validates inline anchors against the PR diff, applies the
self-review + diff-scoping decision flip, and delivers the review as ONE payload: the summary,
every inline comment, and every PR-level row (as a batch section after the summary) go out in a
single `POST .../pulls/{n}/reviews`. This module owns the mechanism only; the input contract and
the failure-mode/common-mistakes documentation stay in skills/workflow-pr-review-post/SKILL.md.

Prints one JSON envelope to stdout on success (schema `swb.pr-review-submit/1`, see
shared/docs/runtime-result-contract.md): `status` is "ok" when the review was submitted (or
deliberately skipped as unchanged) with every row delivered, and "partial" when the review could
not be confirmed or some overflow rows were not delivered — the script still exits 0 either way,
since the caller's cleanup chain must never abort on a posting failure. An input-contract
validation failure (see `validate_payload`) or an invalid outgoing payload (see
`validate_review_payload`) exits 1 with no stdout at all — never a partial envelope.

Comment bodies are rendered here, never by the caller: each --findings-json row
carries structured fields (`severity`, `issue`, `why`, `fix`, `anchor`, and optional
`path`/`line`/`category`) and render_finding() applies the one template —
`**<Sev>**[ · <Category>][ · `path:line`] — <issue>` / `**Why it matters:** <why>` /
`**Suggested fix:** <fix>`, one paragraph each. Rendering happens at post time, after
validate_lines() has settled each row's final anchor, so a row demoted from inline to
PR-level gets its `path:line` in the headline. A row carrying the old free-form `body`
is rejected: the payload is strict rather than silently accepting two shapes.

Finding identity: every row gets a stable key — sha256 over the path, the *text* of its anchor
line at the reviewed head (not the line number, so it survives line shifts) and the normalized
finding content — written as a trailing `finding-key:v1` marker line. The anchor kind is not part
of the key, so a finding demoted from inline to PR-level keeps its identity. Dedup tries an exact
key match first, against the current user's own earlier bodies on every surface and in every
thread state (resolved, unresolved, outdated threads; earlier review bodies; legacy issue-comment
batches; duplicates inside one payload), and only then falls back to fuzzy matching of inline rows
against unresolved threads. Keys from anyone else's bodies are never trusted: a forged marker must
not be able to suppress a real finding.

No-op skip: when the current user's standing decision (their latest decisive review, else COMMENT
if they only ever commented) already equals the event this run would submit, and no new or
carried-over row survives dedup, the run makes zero mutations — no review, no reaction, no
comment — and reports `skipped_reason: "unchanged"`.

Delivery and idempotency: PR-level rows ride in the review body as a batch after the summary,
up to a row and character budget; only the overflow is posted afterwards as issue-comment batches,
the one allowed second mutation. There is no idempotency key on the Reviews endpoint, so every
review body carries a fresh random run marker and a network/5xx failure is resolved by reading
the reviews back and looking for that marker — a review on the same commit from an earlier run
can never be mistaken for this one. Landed: done. Provably absent: retry the identical payload
once. Unreadable, or the retry fails: unconfirmed. A confirmed 422 (stale commit_id, or a line
that went out-of-diff between pre-validate and submit) re-fetches HEAD and the diff, demotes the
rows now out-of-diff into the body and retries once; a second 422 demotes every inline row into
the body for a final body-only POST. Every payload is validated before it is sent.

Retry state: with `--retry-state <path>`, rows whose delivery was not confirmed are written
atomically (mode 0600) to that file, and merged into the next run for the same head and caller;
a merged row that turns out to have landed after all is pruned by the ordinary key dedup. The file
is deleted once nothing is pending.

Why `gh api` bracket-indexed field flags (-f "comments[0][path]=...") can't
build the comments[] payload: they build a JSON *object* keyed by
stringified indices ({"comments":{"0":{...}}}), not an array — GitHub's
Reviews API requires an array and rejects the object shape outright. This
module builds the payload as real Python data structures and serializes it
once with json.dumps, which sidesteps that failure mode entirely (see
shared/docs/gh-api-field-flags.md for the shell-side version of this pitfall, and
shared/docs/shell-echo-vs-printf.md for the related `echo`-corrupts-JSON hazard —
neither applies here since no shell ever sees this payload as a string to
re-interpret).

All `gh` calls funnel through _gh()/_gh_json(), which dispatch to the
sibling swe-workbench-gh-timeout script (resolved via Path(__file__).parent,
the Python equivalent of the bin/ dirname "$0" convention) rather than a
bare PATH lookup, so every network call inherits gh-timeout's per-call
deadline — including gh pr diff, which the prior hand-written prose called
unwrapped.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import uuid
from dataclasses import dataclass, field
from pathlib import Path

REMARK_TEXT = "([swe-workbench](https://github.com/lugassawan/swe-workbench))"
JACCARD_THRESHOLD = 0.4
LINE_FUZZ = 5

_STOPWORDS_MIN_LEN = 1


# ── Pure helpers ─────────────────────────────────────────────────────────────


def tokenize(text: str) -> set[str]:
    return {w for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", (text or "").lower()) if len(w) > _STOPWORDS_MIN_LEN}


def jaccard(a: str, b: str) -> float:
    ta, tb = tokenize(a), tokenize(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


@dataclass
class Thread:
    id: str
    path: str
    line: int
    is_resolved: bool
    head_comment_id: str | None
    head_comment_body: str
    reactor_logins: set[str] = field(default_factory=set)
    is_outdated: bool = False
    head_comment_author: str = ""


def _label_pattern(label: str) -> str:
    """Bold or plain form of a `label:` — `**Label:**`, `**Label**:`, `Label:`."""
    return r"\*{0,2}" + label + r"(?:\s*:\s*\*{0,2}|\s*\*{0,2}\s*:)"


_WHY_LABEL_RE = re.compile(r"^\s*" + _label_pattern("why it matters") + r"\s*", re.IGNORECASE)
_FIX_LABEL_RE = re.compile(r"^\s*" + _label_pattern("suggested fix") + r"\s*", re.IGNORECASE)
_ANY_LABEL_RE = re.compile(_label_pattern("(?:why it matters|suggested fix)"), re.IGNORECASE)
# Leading `**Severity**[ · Category][ · `path:line`] — ` headline. The dash is optional so a
# pre-template body like "**High** text" still loses its severity token.
_HEADLINE_RE = re.compile(r"^\s*\*\*[^*\n]+\*\*(?:\s*·\s*[^·—\n]+)*(?:\s*—\s*)?")
REVIEW_BATCH_MARKER = "<!-- swe-workbench:review-findings -->"
_REVIEW_FINDING_MARKER_PREFIX = "<!-- swe-workbench:review-finding:"
# Keep each post within the consumer's strict section cap.
MAX_BATCH_ROWS = 50
# The key marker lives outside the `review-` namespace: the consumer rejects whole batches
# that carry a stray `review-*` marker line inside a finding body.
_FINDING_KEY_MARKER_PREFIX = "<!-- swe-workbench:finding-key:v1:"
_PROVENANCE_MARKER_RE = re.compile(
    r"(?m)^<!-- swe-workbench:(?:review-(?:findings|finding:[1-9][0-9]*)|finding-key:v1:[0-9a-f]{16}) -->\n?"
)
_RESERVED_PLUGIN_MARKER_RE = re.compile(r"(?m)(?:^|(?<=\r))[ \t\r]*<!-- swe-workbench:")


def _strip_label(label_re: re.Pattern, text: str) -> str:
    return label_re.sub("", text, count=1).strip()


def render_finding(row: dict, pr_level: bool) -> str:
    """The one comment template. Callers pass fields, never prose layout.

    A `why`/`fix` that already carries its own label is stripped rather than
    doubled. `path:line` joins the headline only for pr-level rendering — an
    inline comment is already anchored to its line."""
    headline = f"**{_clean_severity(row['severity'])}**"
    category = (row.get("category") or "").strip()
    if category:
        headline += f" · {category}"
    path = row.get("path")
    if pr_level and path:
        line = row.get("line")
        headline += f" · `{path}:{line}`" if line else f" · `{path}`"
    headline += f" — {row['issue'].strip()}"
    why = _labelled("Why it matters", _strip_label(_WHY_LABEL_RE, row["why"]))
    fix = _labelled("Suggested fix", _strip_label(_FIX_LABEL_RE, row["fix"]))
    return f"{headline}\n\n{why}\n\n{fix}"


def assign_finding_ids(findings: list[dict]) -> list[dict]:
    return [{**finding, "_finding_id": index} for index, finding in enumerate(findings, start=1)]


def _normalize_for_key(text: str) -> str:
    return " ".join((text or "").casefold().split())


def finding_key(row: dict, anchor_text: str) -> str:
    """Stable identity for a finding across runs: path + the anchor line's *text* (not its
    number, so it survives line shifts) + the normalized content. The anchor kind is left out
    on purpose, so a finding demoted from inline to PR-level keeps its key."""
    content = _normalize_for_key(dedup_text(render_finding(row, pr_level=False)))
    parts = (row.get("path") or "", _normalize_for_key(anchor_text), content)
    return hashlib.sha256("\0".join(parts).encode("utf-8")).hexdigest()[:16]


def assign_finding_keys(findings: list[dict], head_sha: str) -> list[dict]:
    keyed = []
    for finding in findings:
        path, line = finding.get("path"), finding.get("line")
        anchor_text = _git_show_line(head_sha, path, line) if path and line else None
        keyed.append({**finding, "_finding_key": finding_key(finding, anchor_text or "")})
    return keyed


def collapse_duplicate_keys(findings: list[dict]) -> tuple[list[dict], int]:
    """Keep the first row per key; returns (unique_rows, dropped_count)."""
    seen: set[str] = set()
    unique: list[dict] = []
    for finding in findings:
        key = finding.get("_finding_key")
        if key is not None and key in seen:
            continue
        if key is not None:
            seen.add(key)
        unique.append(finding)
    return unique, len(findings) - len(unique)


def render_marked_finding(row: dict, pr_level: bool) -> str:
    rendered = f"{_REVIEW_FINDING_MARKER_PREFIX}{row['_finding_id']} -->\n{render_finding(row, pr_level)}"
    if row.get("_finding_key"):
        rendered += f"\n{_FINDING_KEY_MARKER_PREFIX}{row['_finding_key']} -->"
    return rendered


def render_pr_level_batch(findings: list[dict]) -> str:
    # The consumer requires strictly ascending finding IDs.
    ordered = sorted(findings, key=lambda finding: finding["_finding_id"])
    rendered = "\n\n---\n\n".join(render_marked_finding(finding, pr_level=True) for finding in ordered)
    return f"{REVIEW_BATCH_MARKER}\n\n{rendered}"


def _clean_severity(severity: str) -> str:
    """A caller-supplied `**High**` must not render as `****High****`."""
    return severity.strip().strip("*").strip()


def _labelled(label: str, text: str) -> str:
    """`**Label:** text` — but a value opening with a code fence goes on its own paragraph:
    GitHub only starts a fence at the beginning of a line, so a mid-line ```suggestion
    would print as literal text and forfeit the one-click suggestion."""
    sep = "\n\n" if text.startswith(("```", "~~~")) else " "
    return f"**{label}:**{sep}{text}"


def dedup_text(text: str) -> str:
    """Strip presentation so Jaccard compares content only: the headline
    severity/category/`path:line` prefix and both label forms. Without this every
    templated comment shares ~6 label tokens and unrelated findings false-dedup;
    it also maps pre-template run-on threads into the same token space."""
    without_markers = _PROVENANCE_MARKER_RE.sub("", text or "")
    return _ANY_LABEL_RE.sub(" ", _HEADLINE_RE.sub("", without_markers, count=1))


def thread_matches(finding_path: str, finding_line: int, finding_body: str, thread: Thread) -> bool:
    """`finding_body` is the rendered comment; both sides go through dedup_text."""
    if thread.is_resolved:
        return False
    if thread.path != finding_path:
        return False
    if thread.line < 0 or abs(thread.line - finding_line) > LINE_FUZZ:
        return False
    return jaccard(dedup_text(finding_body), dedup_text(thread.head_comment_body)) >= JACCARD_THRESHOLD


def blocking_threads(threads: list[Thread]) -> list[Thread]:
    """Unresolved, non-outdated threads block APPROVE: any severity — GitHub
    review threads carry no severity field, and a reviewer's severity label isn't
    durable across runs. isResolved/isOutdated are the only release valves."""
    return [t for t in threads if not t.is_resolved and not t.is_outdated]


def build_byline(byline: str, is_private: bool | None, n_inline: int, posted_pr_level: int, deduped: int) -> str:
    remark = REMARK_TEXT if is_private is False else ""
    return f"{byline}{remark}. Posted {n_inline} inline comment(s) and {posted_pr_level} PR-level note(s), deduped {deduped}."


def build_summary(
    decision: str, byline_full: str, is_self_review: bool, override_note: str | None = None, n_blocking: int = 0
) -> str:
    if is_self_review:
        return f"{byline_full}\n"
    summary = f"**Review Decision: {decision}**\n\n{byline_full}\n"
    if override_note is not None:
        summary += f"\n_Approved with {n_blocking} unresolved review thread(s) still open — override: {override_note}._\n"
    return summary


def resolve_event(
    decision: str,
    blocking_scope: str,
    current_user: str,
    author_login: str,
    n_blocking_threads: int = 0,
    override: bool = False,
) -> tuple[str, str, bool, bool]:
    """Returns (event, decision, is_self_review, identity_known)."""
    identity_known = bool(current_user) and bool(author_login)
    is_self_review = identity_known and current_user == author_login
    if decision == "COMMENT" and blocking_scope == "OUT-OF-DIFF-ONLY" and identity_known and not is_self_review:
        decision = "APPROVE"
    if decision == "APPROVE" and n_blocking_threads > 0 and not (override and not is_self_review):
        decision = "COMMENT"
    event = "COMMENT" if is_self_review else decision
    return event, decision, is_self_review, identity_known


def partition_findings(findings: list[dict]) -> tuple[list[dict], list[dict]]:
    inline = [f for f in findings if f.get("anchor") == "inline"]
    pr_level = [f for f in findings if f.get("anchor") == "pr-level"]
    return inline, pr_level


# ── gh layer ─────────────────────────────────────────────────────────────────


class PostingError(Exception):
    pass


def _script_dir() -> Path:
    return Path(__file__).resolve().parent


def _check_siblings(script_dir: Path) -> None:
    """Loud, actionable failure on a corrupted install — mirrors the `command -v ... ||
    { echo reinstall or update ...; exit 1; }` preflight every other bin/ script uses,
    adapted for sibling resolution via Path(__file__).parent rather than PATH lookup."""
    for name in ("swe-workbench-gh-timeout", "swe-workbench-diff-line-lookup"):
        path = script_dir / name
        if not (path.is_file() and os.access(path, os.X_OK)):
            raise PostingError(
                f"sibling script {name} not found at {path} — reinstall or update the swe-workbench plugin."
            )


def _gh(args: list[str], input_data: str | None = None) -> subprocess.CompletedProcess:
    cmd = ["bash", str(_script_dir() / "swe-workbench-gh-timeout"), *args]
    # Always pass a (possibly empty) string so subprocess pipes and immediately closes
    # stdin, rather than inheriting the parent's — an inherited pipe with no EOF would
    # hang any call gh doesn't itself need stdin for.
    return subprocess.run(cmd, input=input_data if input_data is not None else "", capture_output=True, text=True)


def _gh_json(args: list[str], input_data: str | None = None):
    """Returns (data, proc) — data is None on non-zero exit or unparseable stdout."""
    proc = _gh(args, input_data=input_data)
    if proc.returncode != 0:
        return None, proc
    try:
        return json.loads(proc.stdout), proc
    except (json.JSONDecodeError, ValueError):
        return None, proc


# ── Step 1 — fetch existing review threads (paginated) ────────────────────────

_THREADS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $after) {
        pageInfo { endCursor hasNextPage }
        nodes {
          id isResolved isOutdated path line startLine
          comments(first: 10) {
            nodes {
              id databaseId body
              author { login }
              reactions(first: 20, content: THUMBS_UP) {
                nodes { user { login } }
              }
            }
          }
        }
      }
    }
  }
}
"""


def _thread_from_node(node: dict) -> Thread:
    comments = (node.get("comments") or {}).get("nodes") or []
    head = comments[0] if comments else None
    reactors: set[str] = set()
    if head:
        for r in (head.get("reactions") or {}).get("nodes") or []:
            login = ((r or {}).get("user") or {}).get("login")
            if login:
                reactors.add(login)
    start_line = node.get("startLine")
    line = node.get("line")
    effective_line = start_line if start_line is not None else line
    return Thread(
        id=node["id"],
        path=node.get("path") or "",
        line=effective_line if effective_line is not None else -1,
        is_resolved=bool(node.get("isResolved")),
        head_comment_id=(head or {}).get("id"),
        head_comment_body=(head or {}).get("body") or "",
        reactor_logins=reactors,
        is_outdated=bool(node.get("isOutdated")),
        head_comment_author=((head or {}).get("author") or {}).get("login") or "",
    )


def fetch_threads(owner: str, repo: str, pr: str) -> list[Thread]:
    threads: list[Thread] = []
    after: str | None = None
    while True:
        args = [
            "api", "graphql",
            "-F", f"number={pr}", "-F", f"owner={owner}", "-F", f"repo={repo}",
            "-f", f"query={_THREADS_QUERY}",
        ]
        if after:
            args += ["-F", f"after={after}"]
        data, proc = _gh_json(args)
        if data is None:
            raise PostingError(f"failed to fetch review threads: {proc.stderr.strip() or proc.stdout.strip()}")
        try:
            rt = data["data"]["repository"]["pullRequest"]["reviewThreads"]
        except (KeyError, TypeError) as exc:
            raise PostingError(f"unexpected reviewThreads response shape: {exc}") from exc
        for node in rt.get("nodes") or []:
            threads.append(_thread_from_node(node))
        page = rt.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        after = page.get("endCursor")
    return threads


# ── Step 2 — dedup + react, pre-validate, assemble ─────────────────────────────

_REACTION_MUTATION = """
mutation($subjectId: ID!) {
  addReaction(input: {subjectId: $subjectId, content: THUMBS_UP}) { reaction { id } }
}
"""


def _parse_json_objects(text: str, strict: bool = False) -> list[dict]:
    """Objects from `gh api --paginate`: one per line (`--jq '.[]'`) or concatenated arrays.
    Lenient by default (an unparseable tail ends the list); strict raises ValueError instead."""
    decoder = json.JSONDecoder()
    objects: list[dict] = []
    pos = 0
    while True:
        while pos < len(text) and text[pos].isspace():
            pos += 1
        if pos >= len(text):
            return objects
        try:
            value, pos = decoder.raw_decode(text, pos)
        except (json.JSONDecodeError, ValueError):
            if strict:
                raise ValueError("unparseable JSON in gh output")
            return objects
        items = value if isinstance(value, list) else [value]
        objects.extend(item for item in items if isinstance(item, dict))


def _fetch_paginated(path: str, what: str) -> list[dict]:
    proc = _gh(["api", "--paginate", path, "--jq", ".[]"])
    if proc.returncode != 0:
        raise PostingError(f"failed to fetch {what}: {proc.stderr.strip() or proc.stdout.strip()}")
    return _parse_json_objects(proc.stdout)


def fetch_reviews(owner: str, repo: str, pr: str) -> list[dict]:
    return _fetch_paginated(f"repos/{owner}/{repo}/pulls/{pr}/reviews", "PR reviews")


def fetch_issue_comments(owner: str, repo: str, pr: str) -> list[dict]:
    return _fetch_paginated(f"repos/{owner}/{repo}/issues/{pr}/comments", "PR issue comments")


_FINDING_KEY_LINE_RE = re.compile(
    r"(?m)^[ \t]*<!-- swe-workbench:finding-key:v1:([0-9a-f]{16}) -->[ \t]*\r?$"
)


def extract_finding_keys(text: str) -> set[str]:
    """Keys only count as a marker on their own line, never quoted mid-sentence."""
    return set(_FINDING_KEY_LINE_RE.findall(text or ""))


def collect_known_keys(threads: list[Thread], reviews: list[dict], issue_comments: list[dict], current_user: str) -> set[str]:
    """Keys the current user already posted, on any surface and in any thread state. Bodies by
    anyone else are untrusted: a forged marker must not be able to suppress a real finding, so
    with identity unknown nothing is trusted and only fuzzy matching remains."""
    if not current_user:
        return set()
    keys: set[str] = set()
    for thread in threads:
        if thread.head_comment_author == current_user:
            keys |= extract_finding_keys(thread.head_comment_body)
    for item in (*reviews, *issue_comments):
        if ((item.get("user") or {}).get("login") or "") == current_user:
            keys |= extract_finding_keys(item.get("body") or "")
    return keys


def _threads_by_key(threads: list[Thread], current_user: str) -> dict[str, list[Thread]]:
    by_key: dict[str, list[Thread]] = {}
    if not current_user:
        return by_key
    for thread in threads:
        if thread.head_comment_author == current_user:
            for key in extract_finding_keys(thread.head_comment_body):
                by_key.setdefault(key, []).append(thread)
    return by_key


def _react(thread: Thread, current_user: str) -> None:
    if current_user and thread.head_comment_id and current_user not in thread.reactor_logins:
        _gh(["api", "graphql", "-F", f"subjectId={thread.head_comment_id}", "-f", f"query={_REACTION_MUTATION}"])


def dedup_findings(
    threads: list[Thread], findings: list[dict], current_user: str, known_keys: set[str] | frozenset = frozenset(),
) -> tuple[list[dict], int, list[Thread]]:
    """Exact key first (any surface, any thread state), then fuzzy matching of inline rows
    against unresolved threads. Returns (survivors, deduped, threads_to_thumbs_up): a thumbs-up
    is owed only to a live (unresolved, current) match, and is left to the caller so that a
    run which turns out to be a no-op can skip it."""
    key_threads = _threads_by_key(threads, current_user)
    survivors: list[dict] = []
    deduped = 0
    to_react: list[Thread] = []
    for finding in findings:
        key = finding.get("_finding_key")
        if key and key in known_keys:
            deduped += 1
            live = next((t for t in key_threads.get(key, []) if not t.is_resolved and not t.is_outdated), None)
            if live is not None:
                to_react.append(live)
            continue
        if finding.get("anchor") == "inline":
            rendered = render_marked_finding(finding, pr_level=False)
            match = next(
                (t for t in threads if thread_matches(finding["path"], finding["line"], rendered, t)),
                None,
            )
            if match is not None:
                deduped += 1
                to_react.append(match)
                continue
        survivors.append(finding)
    return survivors, deduped, to_react


def react_to_threads(threads: list[Thread], current_user: str) -> None:
    reacted: set[str] = set()
    for thread in threads:
        if thread.id not in reacted:
            reacted.add(thread.id)
            _react(thread, current_user)


_DECISIVE_STATES = {"APPROVED": "APPROVE", "CHANGES_REQUESTED": "CHANGES_REQUESTED", "DISMISSED": "DISMISSED"}


def prior_decision(reviews: list[dict], current_user: str) -> str | None:
    """The current user's standing decision from their submitted reviews: the latest decisive
    one (a later COMMENTED reply does not erase an approval), else COMMENT if they only ever
    commented, else None. With identity unknown there is no prior to compare against."""
    if not current_user:
        return None
    mine = [
        r for r in reviews
        if ((r.get("user") or {}).get("login") or "") == current_user
        and r.get("submitted_at") and r.get("state") != "PENDING"
    ]
    decisive = sorted((r for r in mine if r.get("state") in _DECISIVE_STATES), key=lambda r: r["submitted_at"])
    if decisive:
        return _DECISIVE_STATES[decisive[-1]["state"]]
    if any(r.get("state") == "COMMENTED" for r in mine):
        return "COMMENT"
    return None


def should_skip(prior: str | None, event: str, new_rows: int, retry_rows: int) -> bool:
    """A run is a no-op when it would re-submit the decision already standing, with nothing new
    to say. DISMISSED and CHANGES_REQUESTED never equal an event, so they always post."""
    return prior is not None and prior == event and new_rows == 0 and retry_rows == 0


def _git_show_line(head_sha: str, path: str, line: int) -> str | None:
    proc = subprocess.run(["git", "show", f"{head_sha}:{path}"], capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    lines = proc.stdout.splitlines()
    if line < 1 or line > len(lines):
        return None
    content = lines[line - 1]
    return content if content else None


def _line_is_in_diff(path: str, line: int, head_sha: str, pr_diff: str, script_dir: Path) -> bool:
    if not isinstance(line, int) or line < 1:
        return False
    content = _git_show_line(head_sha, path, line)
    if not content:
        return False
    proc = subprocess.run(
        ["bash", str(script_dir / "swe-workbench-diff-line-lookup"), path, content, "--stdin"],
        input=pr_diff, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return False
    return proc.stdout.strip() == f"{path}:{line}"


def _fetch_pr_diff(pr: str) -> str:
    """Loud, actionable failure — an empty diff from a failed/timed-out call would otherwise
    flow silently into validate_lines and demote every inline finding to one pr-level comment,
    with no error and no stderr warning."""
    proc = _gh(["pr", "diff", str(pr)])
    if proc.returncode != 0:
        raise PostingError(f"failed to fetch PR diff: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout


def _refetch_pr_diff(pr: str, stale_pr_diff: str) -> str:
    """Best-effort refetch for the 422-retry path: re-validating against a stale diff after a
    stale-commit_id 422 is the exact bug this exists to fix, but a refetch failure here is a
    degraded retry, not a foundational one — fall back to the stale diff (no worse than before
    this fix) rather than aborting an in-flight submission."""
    proc = _gh(["pr", "diff", str(pr)])
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        print(f"[warn] PR diff re-fetch failed during 422 retry — reusing the pre-retry diff: {detail}", file=sys.stderr)
        return stale_pr_diff
    return proc.stdout


def validate_lines(survivors: list[dict], pr_diff: str, head_sha: str, script_dir: Path) -> tuple[list[dict], list[dict]]:
    """Returns (still_in_diff, demoted_to_pr_level)."""
    in_diff: list[dict] = []
    demoted: list[dict] = []
    for finding in survivors:
        if _line_is_in_diff(finding["path"], finding["line"], head_sha, pr_diff, script_dir):
            in_diff.append(finding)
        else:
            demoted.append(finding)
    return in_diff, demoted


def post_pr_level(pr: str, findings: list[dict]) -> tuple[int, list[dict]]:
    """Post overflow rows as issue-comment batches; returns (posted_count, rows_not_posted)."""
    if not findings:
        return 0, []
    # Slice contiguous ascending finding-ID ranges.
    findings = sorted(findings, key=lambda finding: finding["_finding_id"])
    posted = 0
    failed: list[dict] = []
    for start in range(0, len(findings), MAX_BATCH_ROWS):
        chunk = findings[start : start + MAX_BATCH_ROWS]
        proc = _gh(["pr", "comment", str(pr), "--body", render_pr_level_batch(chunk)])
        if proc.returncode != 0:
            print(
                f"[warn] gh pr comment failed — pr-level batch chunk of {len(chunk)} finding(s) NOT posted.",
                file=sys.stderr,
            )
            failed.extend(chunk)
            continue
        posted += len(chunk)
    return posted, failed


# ── Step 4 — submit ─────────────────────────────────────────────────────────

RUN_MARKER_PREFIX = "<!-- swe-workbench:review-run:"
_ALLOWED_EVENTS = ("APPROVE", "COMMENT")
MAX_REVIEW_TEXT_CHARS = 65_536


def new_run_marker() -> str:
    return f"{RUN_MARKER_PREFIX}{uuid.uuid4()} -->"


@dataclass
class SubmitResult:
    posted_inline: int
    posted_pr_level: int
    submitted: bool
    review_url: str
    # Rows whose delivery is not confirmed: everything when the review itself is unconfirmed,
    # otherwise only the overflow rows whose comment batch failed.
    pending_rows: list[dict] = field(default_factory=list)


def _extract_review_url(stdout: str) -> str:
    try:
        data = json.loads(stdout)
    except (json.JSONDecodeError, ValueError):
        return ""
    return data.get("html_url") or "" if isinstance(data, dict) else ""


def _read_back(owner: str, repo: str, pr: str, run_marker: str) -> tuple[str, str]:
    """Read-your-write check after an ambiguous POST failure. Returns ("landed", url),
    ("absent", "") when the list was read and no review carries this run's marker, or
    ("unknown", "") when the list could not be read or parsed — only "absent" proves the
    review did not land, so only "absent" may be retried. The marker is a fresh random value
    per run, so an earlier review on the same commit can never be mistaken for this one."""
    proc = _gh(["api", "--paginate", f"repos/{owner}/{repo}/pulls/{pr}/reviews", "--jq", ".[]"])
    if proc.returncode != 0:
        return "unknown", ""
    try:
        reviews = _parse_json_objects(proc.stdout, strict=True)
    except ValueError:
        return "unknown", ""
    matches = [r for r in reviews if run_marker in (r.get("body") or "")]
    if not matches:
        return "absent", ""
    return "landed", matches[-1].get("html_url") or ""


def validate_review_payload(payload: dict) -> None:
    """Last gate before a POST: raises PostingError so nothing malformed reaches GitHub."""

    def refuse(problem: str):
        raise PostingError(f"refusing to post an invalid review payload — {problem}")

    if payload.get("event") not in _ALLOWED_EVENTS:
        refuse(f"event must be one of {', '.join(_ALLOWED_EVENTS)}")
    if not re.fullmatch(r"[0-9a-fA-F]{40}", payload.get("commit_id") or ""):
        refuse("commit_id must be a 40-character git SHA")
    body = payload.get("body")
    if not isinstance(body, str) or len(body) > MAX_REVIEW_TEXT_CHARS:
        refuse(f"body must be a string of at most {MAX_REVIEW_TEXT_CHARS} characters")
    texts = [body]
    if "comments" in payload:
        comments = payload["comments"]
        if not isinstance(comments, list) or not comments:
            refuse("comments, when present, must be a non-empty list")
        for index, comment in enumerate(comments):
            if not isinstance(comment, dict):
                refuse(f"comments[{index}] must be an object")
            if not isinstance(comment.get("path"), str) or not comment["path"].strip():
                refuse(f"comments[{index}].path must be a non-empty string")
            if not _is_positive_int(comment.get("line")):
                refuse(f"comments[{index}].line must be a positive integer")
            if comment.get("side") != "RIGHT":
                refuse(f"comments[{index}].side must be RIGHT")
            text = comment.get("body")
            if not isinstance(text, str) or not text.strip() or len(text) > MAX_REVIEW_TEXT_CHARS:
                refuse(f"comments[{index}].body must be a non-empty string within the size limit")
            texts.append(text)
    keys = [key for text in texts for key in _FINDING_KEY_LINE_RE.findall(text)]
    if len(keys) != len(set(keys)):
        refuse("the same finding key appears more than once")


def _post_review(owner: str, repo: str, pr: str, head_sha: str, event: str, body: str, comments: list[dict] | None):
    payload = {"commit_id": head_sha, "event": event, "body": body}
    if comments:
        payload["comments"] = comments
    validate_review_payload(payload)
    return _gh(
        ["api", "--method", "POST", f"repos/{owner}/{repo}/pulls/{pr}/reviews", "--input", "-"],
        input_data=json.dumps(payload),
    )


def _inline_comment(finding: dict) -> dict:
    return {
        "path": finding["path"], "line": finding["line"], "side": "RIGHT",
        "body": render_marked_finding(finding, pr_level=False),
    }


_BATCH_SEPARATOR = "\n\n---\n\n"
# GitHub caps a review body at 65,536 chars; leave headroom for the summary and markers.
BODY_CHAR_BUDGET = 60_000


def build_review_body(summary: str, rows: list[dict]) -> tuple[str, list[dict]]:
    """summary + batch marker + ascending-ID sections, for the longest prefix of `rows` that
    fits the row and character budget. Returns (body, overflow_rows); overflow goes to
    issue-comment batches after the review lands."""
    ordered = sorted(rows, key=lambda row: row["_finding_id"])
    head = f"{summary.rstrip()}\n\n{REVIEW_BATCH_MARKER}\n\n"
    used = len(head)
    fitting: list[str] = []
    for row in ordered:
        piece = render_marked_finding(row, pr_level=True)
        cost = len(piece) + (len(_BATCH_SEPARATOR) if fitting else 0)
        if len(fitting) >= MAX_BATCH_ROWS or used + cost > BODY_CHAR_BUDGET:
            break
        fitting.append(piece)
        used += cost
    if not fitting:
        return summary, ordered
    return head + _BATCH_SEPARATOR.join(fitting), ordered[len(fitting):]


def _classify(proc: subprocess.CompletedProcess) -> str:
    """"ok", "rejected" (a confirmed 422: nothing landed), or "ambiguous" (network/5xx: the
    POST may have landed server-side even though the client never saw success)."""
    if proc.returncode == 0:
        return "ok"
    return "rejected" if "422" in (proc.stdout + proc.stderr) else "ambiguous"


def submit_review(
    *, owner: str, repo: str, pr: str, head_sha: str, event: str,
    inline_rows: list[dict], body_rows: list[dict], summary_fn, run_marker: str,
    pr_diff: str, script_dir: Path,
) -> SubmitResult:
    """summary_fn(n_inline, n_pr_level) -> the review summary text.

    One review POST carries the summary, every inline comment and every PR-level row that
    fits the body budget. Takes structured rows, not rendered comments: a row demoted
    mid-submit must re-render as PR-level with its path:line in the headline.

    Failure ladder, with no per-comment fallback:
      - 422: re-fetch HEAD and the diff, re-validate, demote anything now out-of-diff into the
        body, retry once; a second 422 demotes every inline row and posts a body-only review.
      - network/5xx (ambiguous): read the reviews back by run marker. Landed -> done. Provably
        absent -> retry the same payload once. Unreadable, or the retry fails -> unconfirmed.
    Rows the review did not carry are returned as pending_rows for the retry file."""
    inline, rows = list(inline_rows), list(body_rows)

    def compose() -> tuple[str, list[dict] | None, list[dict]]:
        summary = f"{summary_fn(len(inline), len(rows)).rstrip()}\n\n{run_marker}\n"
        body, overflow = build_review_body(summary, rows)
        return body, [_inline_comment(f) for f in inline] or None, overflow

    body, comments, overflow = compose()
    proc = _post_review(owner, repo, pr, head_sha, event, body, comments)
    outcome = _classify(proc)

    if outcome == "rejected":
        new_head_data, _p = _gh_json(["pr", "view", str(pr), "--json", "headRefOid"])
        head_sha = (new_head_data or {}).get("headRefOid") or head_sha
        if inline:
            pr_diff = _refetch_pr_diff(pr, pr_diff)
            still_in_diff = [f for f in inline if _line_is_in_diff(f["path"], f["line"], head_sha, pr_diff, script_dir)]
            rows += [f for f in inline if f not in still_in_diff]
            inline = still_in_diff
        body, comments, overflow = compose()
        proc = _post_review(owner, repo, pr, head_sha, event, body, comments)
        outcome = _classify(proc)
        if outcome == "rejected" and inline:
            rows += inline
            inline = []
            body, comments, overflow = compose()
            proc = _post_review(owner, repo, pr, head_sha, event, body, None)
            outcome = _classify(proc)

    review_url = ""
    if outcome == "ok":
        review_url = _extract_review_url(proc.stdout)
    elif outcome == "ambiguous":
        found, url = _read_back(owner, repo, pr, run_marker)
        if found == "landed":
            outcome, review_url = "ok", url
        elif found == "absent":
            proc = _post_review(owner, repo, pr, head_sha, event, body, comments)
            if proc.returncode == 0:
                outcome, review_url = "ok", _extract_review_url(proc.stdout)

    if outcome != "ok":
        return SubmitResult(0, 0, False, "", pending_rows=inline + rows)

    posted_overflow, failed_overflow = post_pr_level(pr, overflow)
    return SubmitResult(
        posted_inline=len(inline),
        posted_pr_level=len(rows) - len(overflow) + posted_overflow,
        submitted=True,
        review_url=review_url,
        pending_rows=failed_overflow,
    )


def _repo_is_private(owner: str, repo: str) -> bool | None:
    data, _proc = _gh_json(["repo", "view", f"{owner}/{repo}", "--json", "isPrivate"])
    if not isinstance(data, dict):
        return None
    val = data.get("isPrivate")
    return val if isinstance(val, bool) else None


# ── Input contract validation ───────────────────────────────────────────────

_BLOCKING_SCOPES = ("NONE", "OUT-OF-DIFF-ONLY", "IN-DIFF")


def _remark_problem(text: str) -> str | None:
    return "must not embed the swe-workbench remark" if REMARK_TEXT in text else None


def _byline_problem(byline: str) -> str | None:
    problem = _remark_problem(byline)
    if problem:
        return problem
    if re.search(r"(?i)\bposted\b", byline) or re.search(r"(?i)\bdeduped\b", byline):
        return "must not embed posted/deduped counts"
    if _RESERVED_PLUGIN_MARKER_RE.search(byline):
        # The byline opens the review body, ahead of the batch marker the consumer parses.
        return "must not embed a reserved swe-workbench marker"
    return None


_HEADLINE_FIELDS = ("severity", "issue")  # single-line: they build the comment headline
_BODY_FIELDS = ("why", "fix")  # may span lines (code fences)
_LINE_BREAK_RE = re.compile(r"[\r\n]")
_PATH_UNSAFE_RE = re.compile(r"[\r\n`]")


def _is_positive_int(value) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def _finding_problem(row) -> tuple[str, str] | None:
    """Returns (field, problem) — field is "" for a whole-row problem."""
    if not isinstance(row, dict):
        return "", "each row must be a JSON object"
    if "body" in row:
        return "body", "is no longer accepted — pass issue/why/fix and the script renders the comment body"
    for name in _HEADLINE_FIELDS + _BODY_FIELDS:
        value = row.get(name)
        if not isinstance(value, str):
            return name, "must be a non-empty string"
        if name == "severity":
            value = _clean_severity(value)
        elif name == "why":
            value = _strip_label(_WHY_LABEL_RE, value)
        elif name == "fix":
            value = _strip_label(_FIX_LABEL_RE, value)
        if not value.strip():
            return name, "must be a non-empty string"
        if name in _HEADLINE_FIELDS and _LINE_BREAK_RE.search(value.strip()):
            return name, "must be a single line"
    category = row.get("category")
    if category is not None:
        if not isinstance(category, str):
            return "category", "must be a string"
        if _LINE_BREAK_RE.search(category.strip()):
            return "category", "must be a single line"
    for name in ("severity", "issue", "why", "fix", "category", "path"):
        if not isinstance(row.get(name), str):
            continue
        if REMARK_TEXT in row[name]:
            return name, "must not embed the swe-workbench remark — the byline/remark is a review-level concern only"
        if _RESERVED_PLUGIN_MARKER_RE.search(row[name]):
            return name, "must not embed a reserved swe-workbench marker"
    anchor = row.get("anchor")
    if anchor not in ("inline", "pr-level"):
        return "anchor", "must be 'inline' or 'pr-level'"
    path, line = row.get("path"), row.get("line")
    if anchor == "inline":
        if not isinstance(path, str) or not path.strip():
            return "path", "is required (non-empty) for inline rows"
        if not _is_positive_int(line):
            return "line", "must be a positive integer for inline rows"
    elif path is not None and not isinstance(path, str):
        return "path", "must be a string when given"
    if isinstance(path, str) and _PATH_UNSAFE_RE.search(path):
        # An inline row can be demoted to pr-level, where the path lands in a code span.
        return "path", "must be a single line without backticks"
    if anchor == "pr-level":
        if path is not None and not path.strip():
            return "path", "must be non-empty when given"
        if line is not None and not _is_positive_int(line):
            return "line", "must be a positive integer when given"
        if line is not None and path is None:
            return "line", "requires path"
    return None


def validate_payload(args) -> tuple[list[dict] | None, tuple[str, str] | None]:
    """Returns (findings, error) — error is a (field, problem) tuple, or None on success."""
    if not re.match(r"^[^/\s]+/[^/\s]+$", args.repo or ""):
        return None, ("--repo", "must be in the form owner/repo")
    if not re.match(r"^[1-9][0-9]*$", args.pr or ""):
        return None, ("--pr", "must match [1-9][0-9]*")
    if not re.match(r"^[0-9a-fA-F]{40}$", args.head_sha or ""):
        return None, ("--head-sha", "must be a 40-character git SHA")
    if not args.base:
        return None, ("--base", "must be non-empty")
    if args.decision not in ("APPROVE", "COMMENT"):
        return None, ("--decision", "must be APPROVE or COMMENT")
    if not args.byline:
        return None, ("--byline", "must be non-empty")
    problem = _byline_problem(args.byline)
    if problem:
        return None, ("--byline", problem)
    if not args.caller_tag:
        return None, ("--caller-tag", "must be non-empty")
    if args.blocking_scope not in _BLOCKING_SCOPES:
        return None, ("--blocking-scope", f"must be one of {', '.join(_BLOCKING_SCOPES)}")
    for field_name, value in (("--current-user", args.current_user), ("--author-login", args.author_login)):
        if value and not re.match(r"^[^\s]+$", value):
            return None, (field_name, "must be a plain login string")
    if args.retry_state is not None and (not args.retry_state.strip() or "\0" in args.retry_state):
        return None, ("--retry-state", "must be a non-empty path")
    if args.approve_over_open_threads:
        reason = args.approve_over_open_threads
        if "\n" in reason:
            return None, ("--approve-over-open-threads", "must be a single line")
        if len(reason) > 200:
            return None, ("--approve-over-open-threads", "must be at most 200 characters")
        problem = _remark_problem(reason)
        if problem:
            return None, ("--approve-over-open-threads", problem)

    try:
        raw = sys.stdin.read() if args.findings_json == "-" else Path(args.findings_json).read_text()
    except OSError as exc:
        return None, ("--findings-json", f"could not read file ({exc})")
    try:
        findings = json.loads(raw)
    except (json.JSONDecodeError, ValueError) as exc:
        return None, ("--findings-json", f"invalid JSON ({exc})")
    if not isinstance(findings, list):
        return None, ("--findings-json", "must be a JSON array")
    for i, row in enumerate(findings):
        found = _finding_problem(row)
        if found:
            name, problem = found
            return None, (f"--findings-json[{i}]" + (f".{name}" if name else ""), problem)

    return findings, None


# ── Retry state ──────────────────────────────────────────────────────────────

RETRY_STATE_VERSION = 1
_MAX_RETRY_ROWS = 500
_MAX_RETRY_FILE_BYTES = 4_000_000


def _row_for_state(row: dict) -> dict:
    return {"key": row.get("_finding_key", ""), **{k: v for k, v in row.items() if not k.startswith("_")}}


def load_retry_state(path: str, head_sha: str, caller_tag: str) -> tuple[list[dict], int]:
    """Rows a previous run could not confirm, as (rows, attempts). The file is best-effort
    carry-over, never trusted input: a symlink, a file owned by someone else, an oversized or
    unparseable file, or one written for another head or caller yields nothing, and each row
    must still pass the normal row contract. Rows that did land after all are pruned later by
    the ordinary key dedup, so a stale entry costs nothing."""
    try:
        status = Path(path).lstat()
    except OSError:
        return [], 0
    if not stat.S_ISREG(status.st_mode) or status.st_uid != os.getuid() or status.st_size > _MAX_RETRY_FILE_BYTES:
        return [], 0
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return [], 0
    if (
        not isinstance(data, dict) or data.get("version") != RETRY_STATE_VERSION
        or data.get("head_sha") != head_sha or data.get("caller_tag") != caller_tag
        or not isinstance(data.get("rows"), list)
    ):
        return [], 0
    rows = []
    for item in data["rows"][:_MAX_RETRY_ROWS]:
        if not isinstance(item, dict):
            continue
        row = {k: v for k, v in item.items() if k != "key"}
        if _finding_problem(row) is None:
            rows.append({**row, "_from_retry": True})
    attempts = data.get("attempts")
    return rows, attempts if _is_positive_int(attempts) else 0


def write_retry_state(path: str, head_sha: str, caller_tag: str, event: str, attempts: int, rows: list[dict]) -> bool:
    """Atomic (temp file in the same directory + os.replace) and private (mode 0600)."""
    target = Path(path)
    payload = {
        "version": RETRY_STATE_VERSION, "head_sha": head_sha, "caller_tag": caller_tag,
        "event": event, "attempts": attempts, "rows": [_row_for_state(r) for r in rows],
    }
    tmp_name = ""
    try:
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, tmp_name = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.tmp-")
        with os.fdopen(fd, "w") as handle:
            json.dump(payload, handle, ensure_ascii=True)
        os.replace(tmp_name, target)
        return True
    except OSError as exc:
        print(f"[warn] could not write retry state {path}: {exc}", file=sys.stderr)
        if tmp_name:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
        return False


def clear_retry_state(path: str) -> None:
    try:
        Path(path).unlink()
    except FileNotFoundError:
        pass
    except OSError as exc:
        print(f"[warn] could not remove retry state {path}: {exc}", file=sys.stderr)


# ── CLI ──────────────────────────────────────────────────────────────────────


def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="swe-workbench-pr-review-submit")
    p.add_argument("--repo", required=True)
    p.add_argument("--pr", required=True)
    p.add_argument("--head-sha", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--decision", required=True)
    p.add_argument("--byline", required=True)
    p.add_argument("--caller-tag", required=True)
    p.add_argument("--findings-json", required=True)
    p.add_argument("--blocking-scope", default="IN-DIFF")
    p.add_argument("--current-user", default="")
    p.add_argument("--author-login", default="")
    p.add_argument("--approve-over-open-threads", default="")
    p.add_argument("--debug-dir", default=None)
    p.add_argument("--retry-state", default=None)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_arg_parser().parse_args(argv)

    findings, error = validate_payload(args)
    if error is not None:
        field_name, problem = error
        print(f"workflow-pr-review-post: invalid payload — {field_name} {problem}. Refusing to post.", file=sys.stderr)
        return 1

    owner, repo = args.repo.split("/", 1)
    retry_rows, prior_attempts = ([], 0)
    if args.retry_state:
        retry_rows, prior_attempts = load_retry_state(args.retry_state, args.head_sha, args.caller_tag)
    findings = assign_finding_ids(findings + retry_rows)
    findings = assign_finding_keys(findings, args.head_sha)
    findings, duplicate_rows = collapse_duplicate_keys(findings)
    script_dir = _script_dir()

    try:
        _check_siblings(script_dir)
        threads = fetch_threads(owner, repo, args.pr)
        reviews = fetch_reviews(owner, repo, args.pr) if args.current_user else []
        issue_comments = fetch_issue_comments(owner, repo, args.pr) if args.current_user else []
        known_keys = collect_known_keys(threads, reviews, issue_comments, args.current_user)
        survivors, deduped, to_react = dedup_findings(threads, findings, args.current_user, known_keys)
        deduped += duplicate_rows
        survivors_inline, pr_level_findings = partition_findings(survivors)

        pr_diff = _fetch_pr_diff(args.pr)
        in_diff, demoted = validate_lines(survivors_inline, pr_diff, args.head_sha, script_dir)

        body_rows = pr_level_findings + demoted

        n_blocking = len(blocking_threads(threads))
        override = bool(args.approve_over_open_threads)
        event, decision, is_self_review, _identity_known = resolve_event(
            args.decision, args.blocking_scope, args.current_user, args.author_login, n_blocking, override=override,
        )
        _, decision_without_gate, _, _ = resolve_event(
            args.decision, args.blocking_scope, args.current_user, args.author_login, override=False,
        )
        override_used = override and n_blocking > 0 and not is_self_review and decision == "APPROVE"
        if n_blocking > 0 and decision_without_gate == "APPROVE" and decision != "APPROVE" and not override_used:
            print(
                f"[info] APPROVE downgraded to {decision} — {n_blocking} unresolved review "
                "thread(s) still open, blocking approval.",
                file=sys.stderr,
            )
        override_note = args.approve_over_open_threads if override_used else None

        skipped_reason = ""
        n_retry = sum(1 for row in in_diff + body_rows if row.get("_from_retry"))
        n_new = len(in_diff) + len(body_rows) - n_retry
        if should_skip(prior_decision(reviews, args.current_user), event, n_new, n_retry):
            skipped_reason = "unchanged"
            result = SubmitResult(posted_inline=0, posted_pr_level=0, submitted=False, review_url="")
        else:
            react_to_threads(to_react, args.current_user)
            is_private = _repo_is_private(owner, repo)

            def summary_fn(n_inline: int, pr_level_count: int) -> str:
                byline_full = build_byline(args.byline, is_private, n_inline, pr_level_count, deduped)
                return build_summary(decision, byline_full, is_self_review, override_note=override_note, n_blocking=n_blocking)

            result = submit_review(
                owner=owner, repo=repo, pr=args.pr, head_sha=args.head_sha, event=event,
                inline_rows=in_diff, body_rows=body_rows, summary_fn=summary_fn, run_marker=new_run_marker(),
                pr_diff=pr_diff, script_dir=script_dir,
            )
    except PostingError as exc:
        print(f"workflow-pr-review-post: {exc}", file=sys.stderr)
        return 1

    if args.retry_state:
        if result.pending_rows:
            attempts = prior_attempts + 1 if retry_rows else 1
            write_retry_state(args.retry_state, args.head_sha, args.caller_tag, event, attempts, result.pending_rows)
        else:
            clear_retry_state(args.retry_state)

    if args.debug_dir:
        debug_dir = Path(args.debug_dir)
        debug_dir.mkdir(parents=True, exist_ok=True)
        (debug_dir / f"{args.caller_tag}-threads.json").write_text(
            json.dumps([t.__dict__ for t in threads], default=list, indent=2)
        )
        (debug_dir / f"{args.caller_tag}-payload.json").write_text(
            json.dumps([_inline_comment(f) for f in in_diff], indent=2)
        )

    envelope = {
        "schema": "swb.pr-review-submit/1",
        "status": "partial" if result.pending_rows or not (result.submitted or skipped_reason) else "ok",
        "data": {
            "posted_inline": result.posted_inline,
            "posted_pr_level": result.posted_pr_level,
            "deduped": deduped,
            "submitted": result.submitted,
            "event": event,
            "decision": decision,
            "review_url": result.review_url,
            "blocked_by_unresolved": n_blocking,
            "approve_over_open_threads": bool(args.approve_over_open_threads),
            "override_reason": args.approve_over_open_threads,
            "skipped_reason": skipped_reason,
            "retry_pending": len(result.pending_rows),
        },
        "warnings": (
            [f"{len(result.pending_rows)} finding(s) not delivered — rerun with the same --retry-state to retry."]
            if result.pending_rows else []
        ),
    }
    json.dump(envelope, sys.stdout, ensure_ascii=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
