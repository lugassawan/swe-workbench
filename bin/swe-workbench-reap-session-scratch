#!/usr/bin/env bash
# swe-workbench-reap-session-scratch
# Clear a verified current-session scratch target without removing the target directory.

set -euo pipefail

note() {
  printf 'reap-session-scratch: %s\n' "$*" >&2
}

SWEPT=0

emit() {
  printf 'SWEPT_SESSION_FILES=%s\n' "$SWEPT"
  exit 0
}

reject() {
  note "$*"
  emit
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) || reject "cannot resolve runtime directory — skipping"

shopt -s nullglob
ADAPTERS=("$SCRIPT_DIR"/swe-workbench-session-scratch-adapter-*)
shopt -u nullglob

ACTIVE_OUTPUT=
trap 'if [[ -n "${ACTIVE_OUTPUT:-}" ]]; then rm -f -- "$ACTIVE_OUTPUT"; fi' EXIT

ACTIVE_COUNT=0
for adapter in "${ADAPTERS[@]+"${ADAPTERS[@]}"}"; do
  [[ -f "$adapter" && -x "$adapter" ]] || reject "invalid packaged adapter: $adapter"
  adapter_output=$(mktemp "${TMPDIR:-/tmp}/swe-workbench-session-scratch.XXXXXX") || reject "cannot preserve adapter output — skipping"
  if "$adapter" > "$adapter_output"; then
    if [[ "$ACTIVE_COUNT" -eq 0 ]]; then
      ACTIVE_OUTPUT=$adapter_output
    else
      rm -f -- "$adapter_output"
    fi
    ACTIVE_COUNT=$((ACTIVE_COUNT + 1))
  else
    status=$?
    rm -f -- "$adapter_output"
    [[ "$status" -eq 3 ]] || reject "adapter ${adapter##*/} could not resolve a safe target — skipping"
  fi
done

[[ "$ACTIVE_COUNT" -gt 0 ]] || reject "no active session scratch adapter — skipping"
[[ "$ACTIVE_COUNT" -eq 1 ]] || reject "multiple active session scratch adapters — skipping"

RECORDS=()
while IFS= read -r record || [[ -n "$record" ]]; do
  RECORDS[${#RECORDS[@]}]=$record
done < "$ACTIVE_OUTPUT"

[[ "${#RECORDS[@]}" -ge 4 ]] || reject "adapter descriptor has too few records — skipping"
[[ "${RECORDS[0]}" == "SWB_SESSION_SCRATCH_V1" ]] || reject "unsupported adapter descriptor version — skipping"
[[ "${RECORDS[1]}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || reject "invalid adapter identifier — skipping"

ROOT=${RECORDS[2]}
COUNT=${RECORDS[3]}
[[ "$ROOT" == /* && "$ROOT" != "/" ]] || reject "authorized root is not an absolute non-root directory — skipping"
[[ "$COUNT" =~ ^[0-9]+$ ]] || reject "adapter candidate count is not decimal — skipping"

NORMALIZED_COUNT=$COUNT
while [[ ${#NORMALIZED_COUNT} -gt 1 && "${NORMALIZED_COUNT:0:1}" == "0" ]]; do
  NORMALIZED_COUNT=${NORMALIZED_COUNT#0}
done

RECORD_COUNT=$(( ${#RECORDS[@]} - 4 ))
[[ "$NORMALIZED_COUNT" == "$RECORD_COUNT" ]] || reject "adapter candidate count does not match records — skipping"
[[ "$RECORD_COUNT" -eq 1 ]] || reject "adapter must report exactly one candidate — skipping"

CANDIDATE=${RECORDS[4]}
[[ "$CANDIDATE" != /* && "$CANDIDATE" != */ && "$CANDIDATE" != *//* ]] || reject "candidate is not a relative path — skipping"

CANDIDATE_PARTS=()
IFS=/ read -r -a CANDIDATE_PARTS <<< "$CANDIDATE"
[[ "${#CANDIDATE_PARTS[@]}" -ge 2 ]] || reject "candidate is too shallow — skipping"
for component in "${CANDIDATE_PARTS[@]}"; do
  [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || reject "candidate has an unsafe component — skipping"
done

[[ ! -L "$ROOT" ]] || reject "authorized root is a symlink — skipping"
[[ -d "$ROOT" ]] || reject "authorized root is not a directory — skipping"
[[ -O "$ROOT" ]] || reject "authorized root is not owned by the current user — skipping"
CANON_ROOT=$(cd "$ROOT" 2>/dev/null && pwd -P) || reject "cannot canonicalize authorized root — skipping"

TARGET=$ROOT
for component in "${CANDIDATE_PARTS[@]}"; do
  TARGET="${TARGET}/${component}"
  [[ ! -L "$TARGET" ]] || reject "candidate contains a symlink — skipping"
done

[[ -d "$TARGET" ]] || reject "session scratch target is not a directory — skipping"
[[ -O "$TARGET" ]] || reject "session scratch target is not owned by the current user — skipping"
CANON_TARGET=$(cd "$TARGET" 2>/dev/null && pwd -P) || reject "cannot canonicalize session scratch target — skipping"
case "$CANON_TARGET/" in
  "$CANON_ROOT"/*) ;;
  *) reject "candidate escapes its authorized root — skipping" ;;
esac
if [[ -e "$CANON_TARGET/.git" || -L "$CANON_TARGET/.git" ]]; then
  reject "refusing to touch session scratch containing .git — skipping"
fi

[[ ! -L "$ROOT" ]] || reject "authorized root changed during validation — skipping"
CANON_ROOT_NOW=$(cd "$ROOT" 2>/dev/null && pwd -P) || reject "authorized root vanished during validation — skipping"
[[ "$CANON_ROOT_NOW" == "$CANON_ROOT" ]] || reject "authorized root changed during validation — skipping"

TARGET=$ROOT
for component in "${CANDIDATE_PARTS[@]}"; do
  TARGET="${TARGET}/${component}"
  [[ ! -L "$TARGET" ]] || reject "candidate changed to a symlink — skipping"
done
[[ -d "$TARGET" && -O "$TARGET" ]] || reject "session scratch target changed during validation — skipping"
CANON_TARGET_NOW=$(cd "$TARGET" 2>/dev/null && pwd -P) || reject "session scratch target vanished during validation — skipping"
[[ "$CANON_TARGET_NOW" == "$CANON_TARGET" ]] || reject "session scratch target changed during validation — skipping"
case "$CANON_TARGET_NOW/" in
  "$CANON_ROOT_NOW"/*) ;;
  *) reject "candidate escapes its authorized root — skipping" ;;
esac
if [[ -e "$CANON_TARGET_NOW/.git" || -L "$CANON_TARGET_NOW/.git" ]]; then
  reject "refusing to touch session scratch containing .git — skipping"
fi

shopt -s nullglob dotglob
for entry in "$CANON_TARGET_NOW"/*; do
  if rm -rf -- "$entry" 2>/dev/null; then
    SWEPT=$((SWEPT + 1))
  else
    note "failed to remove $entry — leaving it in place"
  fi
done
shopt -u nullglob dotglob

emit
