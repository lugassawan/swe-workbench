    ".py": {".py", ".pyi"}, ".pyi": {".py", ".pyi"},
    ".go": {".go"},
    ".ts": {".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"},
    ".tsx": {".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"},
