#!/usr/bin/env python3
"""Stdlib-only LSP JSON-RPC client — semantic code navigation reachable from any
agent that holds Bash, regardless of whether the harness's own `LSP` tool is
wired up for subagents on the current build.

Speaks the Language Server Protocol's Content-Length-framed JSON-RPC directly
to a spawned language server (pyright-langserver, gopls, rust-analyzer, …).

The empty-result trap (why `refs`/`callers` prefilter before asking):
a language server only knows about files it has been told to open. Asking
`textDocument/references` for a symbol whose callers live in files the server
has never seen returns an empty array — indistinguishable from "no callers
exist". A caller (e.g. a refactorer deciding whether a rename is safe) would
read that as "safe". So `refs`/`callers` do a text prefilter across the
workspace for the anchor symbol's name, `didOpen` every candidate file (capped
by --max-files), and only then ask the server — and the provenance line always
states how many files were analyzed, so a clean zero is never silently
indistinguishable from an unseeded one.

Known limitation: some servers (rust-analyzer, gopls) index newly-opened
files asynchronously, so a very large prefilter batch can still be mid-index
when the request lands — this script has no portable "indexing settled"
signal to wait on. A suspiciously-low result count on a large prefilter is
worth one retry before trusting it as final.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from collections import namedtuple
from pathlib import Path
from urllib.parse import unquote, urlparse

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NO_SERVER = 3
EXIT_TIMEOUT = 4
EXIT_SERVER_ERROR = 5

DEFAULT_TIMEOUT = 20.0
DEFAULT_MAX_FILES = 40

ServerSpec = namedtuple("ServerSpec", ["name", "cmd"])

# extension -> ServerSpec, keyed to the plugin's language-* skills.
LANGUAGE_SERVERS = {
    ".py": ServerSpec("pyright-langserver", ("pyright-langserver", "--stdio")),
